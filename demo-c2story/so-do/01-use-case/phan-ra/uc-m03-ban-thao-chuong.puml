@startuml UC_M03_BanThao
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 10
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #F5F7FA
    BorderColor #37474F
}
skinparam rectangle {
    BorderColor #37474F
}
left to right direction
title M03 - Bản thảo & chương

actor "Editor" as Editor

rectangle "M03 Bản thảo & chương" {
    usecase "UC-03.01\nXem văn bản gốc" as UC1
    usecase "UC-03.01a\nSao chép toàn văn" as UC1a
    usecase "UC-03.01b\nNhập lại (Re-import)" as UC1b
    usecase "UC-03.02\nSoạn thảo trong Workspace" as UC2
    usecase "UC-03.03\nGợi ý chia chương bằng AI" as UC3
    usecase "UC-03.04\nChia chương tại vị trí" as UC4
    usecase "UC-03.05\nGộp chương vào chương trước" as UC5
    usecase "UC-03.06\nDời ranh giới chương" as UC6
    usecase "UC-03.07\nThêm / xóa / đổi tên chương" as UC7
    usecase "UC-03.08\nSắp xếp lại chương" as UC8
    usecase "UC-03.09\nTái cấu trúc nguyên tử\n(kiểm tra version, OUTDATED tư liệu)" as UC9
    usecase "UC-03.10\nTìm & thay thế" as UC10
    usecase "UC-03.10a\nXem trước số kết quả" as UC10a
    usecase "UC-03.11\nLưu Archive" as UC11
    usecase "UC-03.12\nXem / sao chép / xóa Archive" as UC12
    usecase "UC-03.13\nGhi chú (Notes)" as UC13
    usecase "UC-03.13a\nGắn ghi chú vào chương / shot" as UC13a
    usecase "UC-03.14\nXem & khôi phục phiên bản chương" as UC14
}
rectangle "LLM Provider" as LLM

Editor --> UC1
Editor --> UC2
Editor --> UC3
Editor --> UC7
Editor --> UC8
Editor --> UC10
Editor --> UC11
Editor --> UC12
Editor --> UC13
Editor --> UC14
UC1 <.. UC1a : <<extend>>
UC1 <.. UC1b : <<extend>>
UC2 <.. UC4 : <<extend>>
UC2 <.. UC5 : <<extend>>
UC2 <.. UC6 : <<extend>>
UC4 ..> UC9 : <<include>>
UC5 ..> UC9 : <<include>>
UC6 ..> UC9 : <<include>>
UC8 ..> UC9 : <<include>>
UC3 ..> UC9 : <<include>>
UC10 ..> UC10a : <<include>>
UC13 <.. UC13a : <<extend>>
UC3 --> LLM
@enduml
