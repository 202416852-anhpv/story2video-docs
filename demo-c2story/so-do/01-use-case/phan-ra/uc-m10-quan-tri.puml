@startuml UC_M10_QuanTri
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 10
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #F5F7FA
    BorderColor #37474F
}
skinparam rectangle {
    BorderColor #37474F
}
left to right direction
title M10 - Quản trị

actor "Admin" as Admin

rectangle "M10 Quản trị" {
    usecase "UC-10.01\nCấu hình bảng giá" as UC1
    usecase "UC-10.02\nCấu hình gói đăng ký" as UC2 #DDDDDD
    usecase "UC-10.03\nQuản lý provider & mô hình AI" as UC3
    usecase "UC-10.04\nQuản lý danh mục style" as UC4
    usecase "UC-10.05\nQuản lý danh mục giọng đọc" as UC5
    usecase "UC-10.06\nQuản lý thư viện nhạc & SFX có license" as UC6 #DDDDDD
    usecase "UC-10.07\nGiám sát job" as UC7 #DDDDDD
    usecase "UC-10.07a\nChạy lại job" as UC7a #DDDDDD
    usecase "UC-10.07b\nHoàn tiền thủ công" as UC7b #DDDDDD
    usecase "UC-10.08\nĐiều chỉnh số dư người dùng" as UC8 #DDDDDD
    usecase "UC-10.09\nGhi audit log" as UC9
    usecase "UC-10.10\nXem báo cáo" as UC10 #DDDDDD
    usecase "UC-10.11\nQuản lý danh sách mời beta" as UC11
    usecase "UC-10.12\nÁp trần chi tiêu AI hằng ngày" as UC12
}
rectangle "Payment Gateway" as PAY
rectangle "Email service" as MAIL

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC10
Admin --> UC11
UC11 ..> UC9 : <<include>>
UC12 --> MAIL
UC7 <.. UC7a : <<extend>>
UC7 <.. UC7b : <<extend>>
UC1 ..> UC9 : <<include>>
UC8 ..> UC9 : <<include>>
UC7b ..> UC9 : <<include>>
UC2 --> PAY
caption Nền xám: use case sau MVP (bản chỉ gồm MVP: so-do/mvp/)
@enduml
