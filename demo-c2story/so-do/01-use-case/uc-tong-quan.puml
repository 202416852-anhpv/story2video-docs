@startuml UC_TongQuan_StoryStudio
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 10
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #F5F7FA
    BorderColor #37474F
}
left to right direction

' Tác nhân con người (bên trái)
actor "Guest" as Guest
actor "User" as User
actor "Editor" as Editor
actor "Owner" as Owner
actor "Admin" as Admin

rectangle "AI Story Studio" {
    usecase "M01 Tích hợp SSO & hồ sơ\n(đăng nhập/đăng xuất qua SSO)" as M01
    usecase "M09 Ví & thanh toán" as M09
    usecase "M08 Thư viện tài sản" as M08 #DDDDDD
    usecase "M02 Quản lý dự án & cộng tác" as M02
    usecase "M03 Bản thảo & chương" as M03
    usecase "M04 Thế giới truyện" as M04
    usecase "M05 Sinh tư liệu\n(ảnh + thuyết minh nguyên văn)" as M05
    usecase "M06 Trình chỉnh sửa & xuất video\n(nhạc nền, SFX, chuyển cảnh)" as M06
    usecase "M07 AI Director" as M07 #DDDDDD
    usecase "M10 Quản trị" as M10
}

' Hệ thống ngoài (bên phải)
rectangle "SSO\n(Keycloak; SSO Vbee)" as IdP
rectangle "Payment Gateway" as Pay
rectangle "AI Gateway\n(LLM/Image/TTS/STT)" as AI

Guest --> M01
User --> M09
User --> M08
Owner --> M02
Editor --> M03
Editor --> M04
Editor --> M05
Editor --> M06
Editor --> M07
Admin --> M10

M01 --> IdP
M09 --> Pay
M03 --> AI
M04 --> AI
M05 --> AI
M06 --> AI
M07 --> AI

legend right
  **Quan hệ giữa phân hệ**
  • M07 <<include>> M03, M04, M05, M06
  • M06 <<include>> M05 (ảnh + thuyết minh)
  • M04 <<extend>> M08 (lấy tài sản từ thư viện)
  **Kế thừa tác nhân**: Owner → Editor → User → Guest
  Nền xám: phân hệ sau MVP (bản MVP: so-do/mvp/)
endlegend
@enduml
