@startuml erd_1_tai_khoan_vi
' Sinh tự động từ erd.puml - chỉ sửa erd.puml rồi chạy: python3 so-do/tools/split_erd.py
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam linetype ortho
hide circle
hide empty members
title ERD 1 - Tài khoản, ví & thanh toán

package "Tài khoản & thanh toán" #EEF5FF {
    entity users {
        * id : uuid <<PK>>
        --
        * sso_subject : text <<UQ>>
        email : citext
        display_name : text
        avatar_url : text
        locale : text
        * role : user_role
        * status : user_status
        gateway_customer_id : text
        last_login_at : timestamptz
        consented_at : timestamptz
        consent_version : text
        deletion_requested_at : timestamptz
    }
    entity user_sessions {
        * id : uuid <<PK>>
        --
        * user_id : uuid <<FK>>
        * session_hash : text <<UQ>>
        sso_sid : text
        refresh_token_enc : bytea
        id_token_hint_enc : bytea
        * expires_at : timestamptz
        revoked_at : timestamptz
        last_seen_at : timestamptz
    }
    entity plans #DDDDDD {
        * id : uuid <<PK>>
        --
        * code : text <<UQ>>
        name : text
        price_monthly : numeric
        price_annual : numeric
        gateway_price_ids : jsonb
        features : jsonb
        active : bool
    }
    entity beta_invites {
        * id : uuid <<PK>>
        --
        * email : citext <<UQ>>
        invited_by : uuid <<FK>>
        note : text
        used_by_user_id : uuid <<FK>>
        revoked_at : timestamptz
    }
    entity subscriptions #DDDDDD {
        * id : uuid <<PK>>
        --
        * user_id : uuid <<FK>>
        * plan_id : uuid <<FK>>
        * status : sub_status
        * billing_cycle : text
        current_period_start : timestamptz
        current_period_end : timestamptz
        cancel_at_period_end : bool
        gateway_subscription_id : text <<UQ>>
    }
    entity payments {
        * id : uuid <<PK>>
        --
        * user_id : uuid <<FK>>
        * kind : payment_kind
        plan_id : uuid <<FK>>
        * amount_micro : bigint
        * currency : text
        * status : text
        gateway_ref : text
    }
    entity payment_events {
        * id : uuid <<PK>>
        --
        * gateway_event_id : text <<UQ>>
        * type : text
        payload : jsonb
        processed_at : timestamptz
    }
    entity wallets {
        * user_id : uuid <<PK,FK>>
        --
        * available_micro : bigint
        * held_micro : bigint
        * topup_total_micro : bigint
        * version : int
    }
    entity wallet_ledger_entries {
        * id : uuid <<PK>>
        --
        * user_id : uuid <<FK>>
        * entry_type : ledger_type
        * amount_micro : bigint
        job_id : uuid <<FK>>
        payment_id : uuid <<FK>>
        project_id : uuid <<FK>>
        actor_id : uuid <<FK>>
        reason : text
    }
    entity audit_logs {
        * id : uuid <<PK>>
        --
        * actor_id : uuid <<FK>>
        * action : text
        * target_type : text
        target_id : uuid
        before : jsonb
        after : jsonb
        reason : text
        ip : inet
    }
}
package "Bảng thuộc phân hệ khác" #FFFFFF {
    entity audio_assets #EEEEEE
    entity idempotency_keys #EEEEEE
    entity jobs #EEEEEE
    entity library_assets #EEEEEE
    entity project_members #EEEEEE
    entity projects #EEEEEE
}

users ||--o{ user_sessions
users ||--o{ subscriptions
plans ||--o{ subscriptions
users ||--o{ payments
plans |o--o{ payments
users ||--|| wallets
users ||--o{ wallet_ledger_entries
payments |o--o{ wallet_ledger_entries
jobs |o--o{ wallet_ledger_entries
users |o--o{ beta_invites : invited by
users ||--o{ audit_logs : actor
users ||--o{ projects : owns
users ||--o{ project_members
users ||--o{ library_assets
users |o--o{ audio_assets : uploads
users ||--o{ jobs
users ||--o{ idempotency_keys
@enduml
