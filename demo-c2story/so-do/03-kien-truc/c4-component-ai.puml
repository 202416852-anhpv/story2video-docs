@startuml C4_Component_AI
!include <C4/C4_Component>
title AI Gateway - Components (C4 L3)
LAYOUT_LEFT_RIGHT()

Container(worker, "Job Workers / Alignment Worker", "BullMQ")
Container(api, "API Server", "Director chat")
ContainerDb(db, "PostgreSQL")
System_Ext(prov, "AI Providers", "LLM / Image / TTS / STT / Music-SFX")

Container_Boundary(gw, "AI Gateway") {
    Component(ctx, "ContextBuilder", "TS", "Ngữ cảnh: chương, tóm tắt nội bộ, tài sản, timeline truyện")
    Component(seg, "SentenceSegmenter", "TS", "Tách câu tất định có offset")
    Component(cov, "CoverageValidator", "TS", "Phủ kín chương; sửa ranh giới tất định")
    Component(comp, "PromptCompiler", "TS", "Style → ArtDirection → VisualRules → ChapterRules → brief")
    Component(norm, "SpeechNormalizer", "TS", "Đoạn nguồn → SSML; không đổi chữ")
    Component(wer, "WerScorer", "TS", "Chuẩn hóa hai phía, WER, vị trí lệch")
    Component(mod, "ModerationFilter", "TS", "Kiểm duyệt input / output")
    Component(router, "ProviderRouter", "TS", "Chọn provider/model, fallback, circuit breaker")
    Component(retry, "RetryPolicy", "TS", "Backoff + jitter")
    Component(ad, "Adapters", "TS", "LlmPort, ImagePort, TtsPort, AlignerPort, SttPort, AudioGenPort")
    Component(meter, "UsageMeter", "TS", "ai_usage_records")
}

Rel(worker, ctx, "storyboard, phân tích, gợi ý SFX")
Rel(api, ctx, "Director")
Rel(ctx, db, "Đọc")
Rel(ctx, seg, "")
Rel(seg, cov, "câu → offset")
Rel(cov, db, "shots.source_*")
Rel(worker, comp, "ảnh")
Rel(worker, norm, "thuyết minh")
Rel(worker, wer, "kiểm chứng")
Rel(comp, mod, "")
Rel(norm, mod, "")
Rel(mod, router, "")
Rel(router, retry, "")
Rel(retry, ad, "")
Rel(ad, prov, "HTTPS")
Rel(ad, meter, "usage")
Rel(meter, db, "ghi")
@enduml
