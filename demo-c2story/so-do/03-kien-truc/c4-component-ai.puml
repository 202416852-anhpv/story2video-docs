@startuml C4_Component_AI
!include <C4/C4_Component>
title AI Gateway - Components (C4 L3)
LAYOUT_LEFT_RIGHT()

Container(worker, "Job Workers / Alignment Worker", "BullMQ")
Container(api, "API Server", "Giá ước tính; Director chat (sau MVP)")
ContainerDb(db, "PostgreSQL")
System_Ext(prov, "AI Providers", "Google Gemini (LLM, Image); TTS Server tự host (MVP) / Vbee AIVoice (sau MVP); WhisperX")

Container_Boundary(gw, "AI Gateway") {
    Component(ctx, "ContextBuilder", "TS", "Ngữ cảnh: chương, tóm tắt nội bộ, tài sản, timeline truyện")
    Component(seg, "SentenceSegmenter", "TS", "Tách câu tất định có offset")
    Component(cov, "CoverageValidator", "TS", "Phủ kín chương; sửa ranh giới tất định")
    Component(comp, "PromptCompiler", "TS", "Style → ArtDirection → VisualRules → ChapterRules (sau MVP) → brief")
    Component(norm, "SpeechNormalizer", "TS", "Đoạn nguồn → SSML; quy tắc ký hiệu SYM-01..05; không đổi chữ")
    Component(wer, "WerScorer", "TS", "WER: bộ đánh giá P0; kiểm chứng từng shot sau MVP")
    Component(mod, "ModerationFilter", "TS", "Kiểm duyệt input / output")
    Component(router, "ProviderRouter", "TS", "Chọn provider/model, timeout, circuit breaker; fallback chỉ LLM, mô hình không đắt hơn")
    Component(retry, "RetryPolicy", "TS", "Backoff + jitter")
    Component(ad, "Adapters", "TS", "LlmPort, ImagePort, TtsPort, AlignerPort, SttPort; adapter thật + mock")
    Component(meter, "UsageMeter", "TS", "ai_usage_records (chi phí thực)")
    Component(price, "PriceEstimator", "TS", "Giá ước tính tối đa; số trừ = chi phí thực × 110%")
}

Rel(worker, ctx, "storyboard, phân tích, viết lại brief")
Rel(api, price, "Báo giá trước khi tạo job")
Rel(worker, price, "Quyết toán")
Rel(price, db, "price_rules, ai_usage_records")
Rel(ctx, db, "Đọc")
Rel(ctx, seg, "")
Rel(seg, cov, "câu → offset")
Rel(cov, db, "shots.source_*")
Rel(worker, comp, "ảnh")
Rel(worker, norm, "thuyết minh")
Rel(worker, wer, "EVAL-wer-golden")
Rel(comp, mod, "")
Rel(norm, mod, "")
Rel(mod, router, "")
Rel(router, retry, "")
Rel(retry, ad, "")
Rel(ad, prov, "HTTPS / HTTP nội bộ")
Rel(ad, meter, "usage")
Rel(meter, db, "ghi")
@enduml
