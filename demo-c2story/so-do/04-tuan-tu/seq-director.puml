@startuml Seq_Director
!theme plain
!include _style-tuan-tu.iuml
autonumber
title UC-07.02: AI Director tự động (bước 2 → 4, dựng bản nháp timeline) (sau MVP)
actor Editor $NGUOI_DUNG
participant "Web App" as Web $GIAO_DIEN
participant "API / Director module" as DIR $API
database PostgreSQL as DB $DU_LIEU
participant "Job pipeline\n(như thao tác tay)" as JOBS $WORKER
participant "LLM" as LLM $BEN_NGOAI

Editor -> Web : Bật Director tự động
Web -> DIR : POST /director/plan
DIR -> DB : INSERT director_plans(RUNNING)
loop tới khi COMPLETED / PAUSED / AWAITING_INPUT
    DIR -> DB : UC-07.02a: đọc trạng thái dự án
    DIR -> DIR : nextStep() = bước đầu tiên chưa xong;\nước tính số tiền còn cần → step_state, estimated_remaining_micro
    alt pickStyle (chưa có style)
        DIR -> DB : plan AWAITING_INPUT(reason=PICK_STYLE)
        DIR --> Web : SSE director.plan + mở Styles Library
        Editor -> Web : Chọn style
        Web -> DIR : POST plan:submit-input {styleId}
    else split
        DIR -> JOBS : SUGGEST_SPLITS → restructure
    else cast
        DIR -> JOBS : ANALYZE_ASSETS
        DIR -> DB : plan AWAITING_INPUT(reason=REVIEW_CAST)
        DIR --> Web : "Review your cast & places" + tổng giá ảnh tham chiếu
        Editor -> Web : Duyệt cast
        Web -> DIR : plan:submit-input {approvedAssetIds}
        DIR -> JOBS : GENERATE_ASSET_IMAGE × n (HOLD giá ước tính)
    else pickVoice
        DIR -> DB : plan AWAITING_INPUT(reason=PICK_VOICE)
        Editor -> Web : Nghe thử, chọn giọng
        Web -> DIR : plan:submit-input {voiceId}
    else media
        DIR -> JOBS : GENERATE_MEDIA_CHAPTER cho mỗi chương chưa "Sẵn sàng dựng"\n(storyboard tự động + ảnh + thuyết minh nguyên văn)
    else verify
        DIR -> DB : nếu có NEEDS_REVIEW → AWAITING_INPUT(reason=REVIEW_NARRATION)
    else draftTimeline
        DIR -> JOBS : dựng bản nháp timeline cho mỗi chương
    end
    JOBS --> DIR : sự kiện job xong
    DIR -> DB : cập nhật step_state; director_messages (tiến độ)
    DIR --> Web : SSE director.plan
end
opt Editor bấm Pause
    Web -> DIR : plan:pause
    DIR -> DB : PAUSED (job đang chạy được để xong)
end
opt thiếu số dư
    DIR -> DB : AWAITING_INPUT(reason=INSUFFICIENT_BALANCE)
end
DIR -> DB : plan COMPLETED
DIR --> Web : "Mọi chương đã sẵn sàng dựng video"\n→ Editor mở trình chỉnh sửa: nhạc nền, SFX, xuất

== Chat ra lệnh (UC-07.01) ==
Editor -> Web : "Làm lại shot 3 chương 2, trời tối hơn"
Web -> DIR : POST /director/messages (SSE)
DIR -> LLM : messages + tóm tắt dự án + tools (theo quyền)
note right of DIR
  Tool registry KHÔNG có thao tác ghi văn bản chương.
  Văn bản truyện đưa vào prompt chỉ là dữ liệu, không phải chỉ dẫn.
end note
alt lệnh thiếu tham số (UC-07.01a)
    LLM --> DIR : cần làm rõ
    DIR --> Web : Hỏi lại "Chương nào? Shot số mấy?" (kèm gợi ý)
    Editor -> Web : Trả lời → quay lại bước gọi LLM
else yêu cầu sửa / viết lại / tóm tắt văn bản truyện (UC-07.01c)
    DIR --> Web : Từ chối, giải thích nguyên tắc nguyên văn (BR-19, BR-21);\ngợi ý tự sửa ở Workspace hoặc chia video (UC-06.16b)
else yêu cầu soạn hộ nội dung minh họa (UC-07.01d)
    DIR --> Web : Bản nháp prompt / brief / Visual Rule (chưa áp dụng)
    Editor -> Web : Chấp nhận → áp dụng bằng thao tác tương ứng (If-Match)
else tool_call miễn phí, vd. rewrite_shot(2,3,"trời tối hơn")
    LLM --> DIR : tool_call
    DIR -> JOBS : REWRITE_SHOT
    JOBS --> DIR : xong
    DIR --> Web : tool_result + phản hồi
else tool_call tốn phí (UC-07.01b)
    LLM --> DIR : tool_call
    DIR -> DB : director_tool_proposals(PENDING) — chưa HOLD tiền, chưa tạo job
    DIR --> Web : tool_proposal (thao tác, phạm vi, giá, số dư)
    alt Editor đồng ý
        Web -> DIR : POST tool-proposals/{tpid}:confirm (Idempotency-Key)
        DIR -> DB : HOLD tiền của người xác nhận (BR-03);\nproposal CONFIRMED (decided_by, job_id)
        DIR -> JOBS : tạo job như thao tác tay
        JOBS --> DIR : xong
        DIR --> Web : tool_result + phản hồi
    else Editor hủy
        Web -> DIR : từ chối
        DIR -> DB : proposal REJECTED
    else không đủ số dư
        DIR --> Web : 402 INSUFFICIENT_BALANCE (proposal giữ PENDING)
    end
end
@enduml
