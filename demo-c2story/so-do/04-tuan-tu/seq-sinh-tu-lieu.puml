@startuml Seq_SinhTuLieu
!theme plain
!include _style-tuan-tu.iuml
autonumber
'@sau-mvp
title UC-05.07 (+05.07a, 05.07b, 05.07c) + UC-05.08 + UC-05.18 + UC-06.01a: Sinh tư liệu chương (ảnh + thuyết minh nguyên văn),\ntheo dõi tiến độ, sinh lại có chọn lọc, dựng timeline nháp; BullMQ Flow (ADR-15); BR-11, BR-12, BR-14, BR-34; WR-05
'@/sau-mvp
'@mvp title UC-05.07 (+05.07a, 05.07b, 05.07c) + UC-05.08 + UC-05.18 + UC-06.01a (MVP): Sinh tư liệu chương (ảnh + thuyết minh nguyên văn),\ntheo dõi tiến độ, sinh lại có chọn lọc, dựng timeline nháp; BullMQ Flow (ADR-15); BR-11, BR-12, BR-14, BR-34; WR-05

actor Editor $NGUOI_DUNG
participant "Web App\n(bảng tiến độ,\nmedia bin)" as Web $GIAO_DIEN
box "API Server" $BOX_API
participant "MediaController\n→ MediaGenerationService" as MG $API
participant "PriceEstimator" as PE $API
participant "Realtime (SSE)" as RT $API
participant "JobService" as JOBS $API
participant "editor.TimelineBuilder" as TB $API
end box
database PostgreSQL as DB $DU_LIEU
queue "Redis / BullMQ\n(Flow cha–con)" as Q $DU_LIEU
box "Worker" $BOX_WORKER
participant "MediaOrchestrator\n(GENERATE_MEDIA_CHAPTER)" as ORC $WORKER
participant "StoryboardDraftHandler" as SB $WORKER
participant "ShotImageHandler" as IMG $WORKER
participant "NarrateSegmentHandler\n(+ VERIFY_NARRATION)" as NAR $WORKER
end box

== Báo giá (UC-05.07 bước 2, UC-05.07c bước 3) ==
Editor -> Web : Chọn chương, "Sinh tư liệu" | "Sinh lại phần thiếu / lỗi"\n(only: MISSING | FAILED | OUTDATED | FLAGGED | ALL; parts: IMAGE, NARRATION)
Web -> MG : GET /projects/{pid}/media:quote?chapterIds&only&parts
MG -> DB : storyboard hiện hành? số shot; Σ (source_end − source_start);\nảnh DONE hợp lệ + ảnh UPLOAD bị loại (BR-14)
MG -> PE : estimateMax(storyboard nếu thiếu + ảnh × n + TTS theo ký tự)
note right of PE : Chưa có storyboard: n ước tính theo độ dài chương\nvà target_shot_seconds (mặc định 20 s, QĐ-138)
PE --> MG : {shots, storyboardUsd, imagesUsd, ttsChars, ttsUsd, totalUsd}
MG --> Web : 200 | "Không có phần nào cần sinh lại" (2a)
Editor -> Web : Xác nhận

== Tạo job cha + Flow (UC-05.07 bước 3) ==
Web -> MG : POST /projects/{pid}/media:generate {chapterIds, only, parts} (Idempotency-Key)
MG -> JOBS : createPaidJob(GENERATE_MEDIA_CHAPTER, chapterId, held = totalUsd)
ref over JOBS, DB : seq-vong-doi-job §2: 402 (3a) / 503 (3b);\nHOLD **một lần** giá ước tính tối đa ở job cha (WR-05);\njob con không giữ tiền
JOBS -> DB : cùng giao dịch: chapters.locked_by_job_id = job cha (BR-12);\nchương đã bị khóa → 423
JOBS -> Q : FlowProducer.add(cha → con) sau commit
JOBS --> Web : 202 {jobId, estimatedCostUsd}
MG -> RT : chapter.updated (DRAFT → GENERATING)

== Dựng storyboard tự động nếu thiếu (UC-05.07a) ==
Q -> ORC : job cha (RUNNING, heartbeat)
ORC -> DB : chapters.current_storyboard_id?
alt chưa có
    ORC -> Q : con STORYBOARD_DRAFT (kind = INITIAL, target_shot_seconds)
    Q -> SB : chạy như seq-storyboard-sinh-anh §1\n(tách câu → Gemini → CoverageValidator)
    alt thành công
        SB --> ORC : N shot, đặt hiện hành (BR-07)
        note right of ORC : Không điều chỉnh HOLD theo N thực tế (4a):\ngiá đã ước tính theo trần trên; số trừ ≤ số giữ
    else lỗi sau retry (3a)
        SB --> ORC : FAILED
        ORC -> DB : chương NEEDS_ATTENTION; quyết toán job cha (CAPTURE chi phí đã có,\nRELEASE phần còn lại); mở khóa;\ncác chương khác trong lượt vẫn chạy
    end
end

== Fan-out mỗi shot (UC-05.07 bước 5) ==
ORC -> DB : danh sách shot × phần cần chạy theo only/parts
ORC -> Q : con GENERATE_SHOT_IMAGE × a, NARRATE_SEGMENT × b\n(held_micro = 0; chỉ ghi ai_usage_records)
par ảnh (concurrency của queue image)
    Q -> IMG : GENERATE_SHOT_IMAGE(shot)
    IMG -> IMG : như seq-storyboard-sinh-anh §3\n(PromptCompiler → Gemini Image)
    IMG -> DB : illustration DONE | FAILED; job con SUCCEEDED | FAILED;\njobs cha.heartbeat_at = now()
    IMG -> RT : illustration.ready | job.updated
else thuyết minh (concurrency của queue tts)
    Q -> NAR : NARRATE_SEGMENT(shot)
    NAR -> NAR : như seq-thuyet-minh-nguyen-van\n(hash → SpeechNormalizer → TTS Server → WhisperX)
'@sau-mvp
    NAR -> NAR : sau MVP: STT + WER → VERIFIED | NEEDS_REVIEW
'@/sau-mvp
    NAR -> DB : narration DONE | FAILED; flagged_at = NULL;\njob con SUCCEEDED | FAILED; jobs cha.heartbeat_at = now()
    NAR -> RT : narration.updated | job.updated
end
RT --> Web : SSE illustration.ready, narration.updated, job.updated (từng shot, từng phần)

== Theo dõi tiến độ (UC-05.07b) và media bin (UC-05.08) ==
Web -> MG : GET /projects/{pid}/media?chapterId (ảnh chụp ban đầu)
MG -> DB : chương → shot → {illustration, narration, sourceText,\ndurationMs, status, flagged}
MG --> Web : bảng tiến độ (PENDING / GENERATING / DONE / FAILED / OUTDATED)
alt mất kết nối SSE
'@sau-mvp
    Web -> RT : nối lại với Last-Event-ID (phát lại từ outbox);\nthiếu sự kiện thì tải lại ảnh chụp (3a)
'@/sau-mvp
'@mvp     Web -> MG : tải lại ảnh chụp rồi nghe tiếp (không phát lại sự kiện, ADR-23)
end

== Kết thúc job cha: một giao dịch ==
Q -> ORC : mọi con đã xong (Flow)
ORC -> DB : BEGIN; đếm trạng thái ảnh, thuyết minh của mọi shot
'@sau-mvp
alt mọi shot ảnh DONE và thuyết minh DONE (sau MVP: VERIFIED / ACCEPTED)
'@/sau-mvp
'@mvp alt mọi shot ảnh DONE và thuyết minh DONE
    ORC -> DB : chapters.media_status = READY_TO_EDIT
    ORC -> TB : createDraftTimeline(chapterId) (UC-06.01a)
    TB -> DB : timelines + tracks Video, Thuyết minh (khóa), Phụ đề (nguyên văn),\nNhạc nền, SFX; mỗi shot 1 item IMAGE + 1 item NARRATION;\nKen Burns luân phiên, crossfade 0,5 s
else còn lỗi (5a)
    ORC -> DB : chapters.media_status = NEEDS_ATTENTION
end
ORC -> DB : quyết toán (WR-05): CAPTURE min(Σ cost các con SUCCEEDED × 1,10, held),\nRELEASE phần còn lại; daily_ai_budgets: reserved −= x_cost, spent += Σ cost mọi con;\nchapters.locked_by_job_id = NULL; jobs SUCCEEDED; COMMIT
ORC -> RT : chapter.media-ready {timelineId, chargedUsd, releasedUsd}\n| chapter.updated {mediaStatus: NEEDS_ATTENTION}
RT --> Web : SSE
note over ORC, DB : Job cha chờ con không tự heartbeat; mỗi con kết thúc cập nhật heartbeat của cha.\nWorker chết giữa chừng: reconciler quyết toán job cha như trên,\nhủy con còn chờ, mở khóa chương (seq-vong-doi-job §6)

== Nghe & đánh dấu cần sinh lại (UC-05.18, không bắt buộc) ==
Editor -> Web : "Nghe" (tô sáng từng từ theo word_timings)
Editor -> Web : "Đánh dấu cần sinh lại" | "Bỏ đánh dấu"
Web -> MG : POST | DELETE …/shots/{shid}/narration:flag
MG -> DB : narrations.flagged_at = now() | NULL
MG -> RT : narration.updated
Editor -> Web : "Sinh lại shot đã đánh dấu" → quay lại báo giá với only = FLAGGED\n(hoặc thêm từ điển phát âm trước, UC-05.12)
note over Editor, TB
  Bước này **chỉ** sinh ảnh + thuyết minh. Nhạc nền và SFX thêm trong trình chỉnh sửa (UC-06.01).
  Shot đánh dấu không chặn xuất video, chỉ cảnh báo ở UC-06.16a (BR-34).
end note
@enduml
