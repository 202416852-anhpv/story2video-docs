@startuml Seq_Storyboard_SinhAnh
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam sequenceMessageAlign left
autonumber
title UC-05.01 + UC-05.09 + UC-05.10: Lập storyboard, sinh ảnh shot và thay ảnh tải lên
actor Editor
participant "Web App" as Web
participant "API Server" as API
database PostgreSQL as DB
queue "BullMQ" as Q
participant "Worker" as W
participant "AI Gateway" as GW
participant "LLM" as LLM
participant "Image Provider" as IMG
participant "Object Storage" as S3

== Tạo bản nháp storyboard ==
Editor -> Web : "Create storyboard draft" (chương 1)
Web -> API : POST .../chapters/{cid}/storyboards {kind: INITIAL}
API -> DB : INSERT jobs(STORYBOARD_DRAFT)
API --> Web : 202
Q -> W : job
W -> DB : Đọc chương, story_assets, timeline,\nvisual_rules, chapter_rules
W -> W : Tách câu tất định, đánh số câu
W -> GW : ContextBuilder + complete(schema Shot[])\n(LLM chỉ trả startSentence/endSentence)
GW -> LLM : prompt + danh sách câu đánh số
LLM --> GW : shots JSON (chỉ số câu + brief)
W -> W : CoverageValidator: câu → offset,\nsửa hở/chồng lấn, kiểm tra concat == content
W -> W : Ánh xạ tên → asset_id (tên + bí danh);\nkhông khớp → unlinked
W -> DB : INSERT storyboard_drafts, shots(source_start/end/hash), shot_asset_refs;\nchapters.current_storyboard_id (nếu là bản đầu)
W --> Web : SSE job.updated (SUCCEEDED)

== Sinh ảnh một shot ==
Editor -> Web : "Generate" trên shot 3
Web -> API : POST .../shots/{shid}:generate-image\nIdempotency-Key
API -> DB : BEGIN\nSELECT credit_balances FOR UPDATE
alt đủ credit
    API -> DB : ledger HOLD(1); balances; jobs(QUEUED); outbox; COMMIT
    API --> Web : 202 {jobId, creditCost: 1}
else thiếu
    API -> DB : ROLLBACK
    API --> Web : 402 INSUFFICIENT_CREDITS
end
Q -> W : job (queue image)
W -> DB : jobs RUNNING; illustrations(PENDING)
W -> GW : PromptCompiler: Style → ArtDirection → VisualRules\n→ ChapterRules → brief + facts
GW -> GW : Moderation input
GW -> S3 : Lấy ảnh tham chiếu cast/location/item
GW -> IMG : generate(prompt, references)
alt thành công
    IMG --> GW : ảnh
    GW -> GW : Moderation output; UsageMeter
    GW -> S3 : PUT media
    W -> DB : BEGIN; media_files, illustrations(DONE, vN+1),\nshots.current_illustration_id, ledger CAPTURE(1),\njobs SUCCEEDED; COMMIT
    W --> Web : SSE illustration.ready
else lỗi tạm thời
    W -> W : Retry (backoff, tối đa 3)
else lỗi vĩnh viễn / vi phạm
    W -> DB : BEGIN; ledger RELEASE(1); illustrations FAILED;\njobs FAILED; COMMIT
    W --> Web : SSE job.updated (FAILED, error_code)
end

== Thay ảnh bằng ảnh tải lên (UC-05.10, nhánh 1a) ==
Editor -> Web : "Thay bằng ảnh của tôi" trên shot 3
Web -> API : POST .../shots/{shid}/illustrations:upload (multipart)
API -> API : Kiểm MIME thật, kích thước, cạnh ngắn >= 512 px,\nquét malware, bỏ EXIF (NFR-SEC-10)
alt hợp lệ
    API -> S3 : PUT media
    API -> DB : BEGIN; media_files, illustrations(UPLOAD, DONE, vN+1,\nshot_version = shots.version),\nshots.current_illustration_id; COMMIT\n(không HOLD credit, không tạo job)
    API --> Web : 201 {illustrationId}
    API --> Web : SSE illustration.ready
else không hợp lệ
    API --> Web : 422 (lý do)
end
note right of API : Sinh ảnh hàng loạt (UC-05.07, UC-05.07c)\nbỏ qua shot có ảnh hiện hành UPLOAD (BR-14)

== Sửa ảnh (UC-05.10a, UC-05.10b, UC-05.10c) ==
alt Describe → Edit hoặc Fix a spot (1 credit)
    Editor -> Web : Mô tả thay đổi (kèm mask nếu tô vùng)
    Web -> API : POST .../illustrations/{iid}:edit {instruction, mask?}\nIdempotency-Key
    API -> DB : HOLD(1); jobs(EDIT_IMAGE / INPAINT_IMAGE, QUEUED); mask → media_files
    API --> Web : 202
    Q -> W : job
    W -> GW : moderation input; edit(ảnh gốc, instruction, mask?)
    GW -> IMG : edit / inpaint
    alt thành công
        IMG --> GW : ảnh mới
        W -> DB : illustrations(EDIT hoặc INPAINT, parent = ảnh gốc, DONE),\nshots.current_illustration_id, CAPTURE(1)
        W --> Web : SSE illustration.ready
    else lỗi sau 3 lần / vi phạm chính sách
        W -> DB : RELEASE(1); illustrations FAILED (ảnh cũ vẫn là hiện hành)
        W --> Web : SSE job.updated (FAILED)
    end
else Khôi phục phiên bản ảnh (miễn phí)
    Editor -> Web : Chọn phiên bản trong lịch sử, "Make current"
    Web -> API : POST .../illustrations/{iid}:make-current
    API -> DB : shots.current_illustration_id = iid (không tạo bản ghi, không tốn credit)
    API --> Web : 200 + SSE illustration.ready
end
@enduml
