@startuml Seq_ThanhToan
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam sequenceMessageAlign left
autonumber
title UC-09.02 + UC-09.03a + UC-09.08a: Đăng ký gói qua Stripe (tài khoản của nhóm)
actor User
participant "Web App" as Web
participant "API" as API
database PostgreSQL as DB
participant "Stripe" as ST

User -> Web : Chọn Creator / Monthly
Web -> API : POST /billing/checkout-sessions {planCode, cycle}
API -> API : Gói còn active? User chưa có gói trả phí đang hoạt động?
alt gói không hợp lệ / đã có gói trả phí
    API --> Web : 404 / 422 (đã có gói → dùng UC-09.04)
else hợp lệ
    API -> ST : (tạo customer nếu chưa có → users.gateway_customer_id)\nCreate Checkout Session\n(client_reference_id = userId, price id, success_url, cancel_url)
    ST --> API : session.url
    API --> Web : {url}
    Web -> ST : redirect
    User -> ST : Thanh toán
    alt hủy
        ST --> Web : redirect cancel_url → Pricing (không đổi gì)
    else thanh toán xong
        ST --> Web : redirect success_url → Dashboard ("Đang xử lý thanh toán")
    end
end
ST -> API : webhook (checkout.session.completed / invoice.paid / invoice.payment_failed /\ncustomer.subscription.deleted / refund / chargeback)
API -> API : Xác thực chữ ký + timestamp (≤ 5 phút)
alt chữ ký sai
    API --> ST : 400, log bảo mật
else chữ ký đúng
    API -> DB : INSERT payment_events (gateway_event_id UNIQUE)
    alt event mới
        API -> DB : UC-09.08a — BEGIN theo loại event:\n• gói paid: subscriptions ACTIVE; EXPIRE credit SUBSCRIPTION cũ; GRANT credit kỳ mới\n• pack: PURCHASE vào bucket PACK\n• payment_failed: PAST_DUE + email\n• subscription.deleted: CANCELED; EXPIRE credit gói\n• refund / chargeback: ADJUST âm (khóa thao tác tốn phí nếu số dư âm)\nghi payments + credit_ledger_entries; processed_at; COMMIT
        alt lỗi xử lý
            API -> DB : ROLLBACK
            API --> ST : 500 (cổng gửi lại)
        else thành công
            API --> ST : 200
        end
    else trùng event
        API -> API : bỏ qua (idempotent)
        API --> ST : 200
    end
end
Web -> API : GET /me/dashboard (hoặc nhận SSE khi webhook đến chậm)
API --> Web : Creator, 300 credits
@enduml
