@startuml Seq_ThuyetMinhNguyenVan
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam sequenceMessageAlign left
autonumber
title UC-05.13: Sinh và kiểm chứng thuyết minh nguyên văn (BR-19)
actor Editor
participant "Web App" as Web
participant "API" as API
database PostgreSQL as DB
participant "TTS Worker" as W
participant "SpeechNormalizer" as N
participant "TTS Provider" as TTS
participant "Alignment Worker\n(Aligner + STT)" as AL
participant "Object Storage" as S3

Editor -> Web : "Sinh thuyết minh chương 1"
Web -> API : GET .../narrations:quote
API -> DB : SUM(source_end - source_start) các shot hiện hành
API --> Web : {chars: 9895, credits: 10}
Editor -> Web : Xác nhận
Web -> API : POST .../chapters/{cid}/narrations (Idempotency-Key)
API -> DB : HOLD 10; jobs NARRATE_CHAPTER + NARRATE_SEGMENT × n;\nkhóa chương (BR-12)
API --> Web : 202

loop mỗi shot (song song có giới hạn)
    W -> DB : UC-05.13a: đọc chapter.content, shot.source_start/end/hash
    W -> W : text = content[start:end]
    alt sha256(text) != shot.source_hash
        W -> DB : narration OUTDATED; RELEASE phần credit
    else khớp
        W -> N : UC-05.13b: text + pronunciation_entries + settings
        N --> W : SSML (chỉ break / alias / phoneme;\nbỏ ký hiệu markdown) + normalization_log
        note right of N
          Kiểm tra ngược: bỏ thẻ SSML và áp ngược alias
          → chỉ khác text ở các biến đổi mức phát âm
          được phép (BR-19)
        end note
        alt kiểm tra ngược thất bại
            W -> DB : narration FAILED; RELEASE; cảnh báo P1
        else đạt
            W -> TTS : speak(SSML, voice, speed)\n(chia theo câu nếu dài; retry khi lỗi tạm thời)
            alt TTS lỗi sau retry / vi phạm chính sách
                W -> DB : narration FAILED; RELEASE (không tự sửa văn bản, BR-18)
            else audio hợp lệ
                TTS --> W : audio (+ timestamp nếu có)
                W -> S3 : PUT narration.mp3
                W -> AL : UC-05.13c: align(audio, text) + transcribe(audio)
                alt Aligner / STT lỗi sau retry
                    AL --> W : lỗi
                    W -> DB : narration FAILED; RELEASE
                else có kết quả
                    AL --> W : word_timings, transcript
                    W -> W : WER = dist(normalize(text), normalize(transcript))
                    alt WER <= ngưỡng (mặc định 0,03)
                        W -> DB : narrations(VERIFIED, word_timings, wer)
                    else WER > ngưỡng (> 10% luôn cần người duyệt)
                        W -> DB : narrations(NEEDS_REVIEW, word_timings, mismatches[])
                    end
                    W -> DB : CAPTURE phần credit
                end
            end
        end
    end
    W --> Web : SSE narration.updated
end
W -> DB : mở khóa chương

opt Có shot NEEDS_REVIEW
    Editor -> Web : Nghe, xem từ tô đỏ
    alt Thêm từ điển phát âm
        Web -> API : POST /pronunciations
        Web -> API : POST .../shots/{shid}/narration:generate
    else Chấp nhận thủ công (UC-05.14a)
        Editor -> Web : Nghe, tích "Tôi đã nghe và lời đọc đúng nguyên văn"
        Web -> API : POST .../narration:accept
        alt narration vẫn NEEDS_REVIEW
            API -> DB : ACCEPTED (accepted_by, accepted_at)
            API --> Web : 200 + SSE narration.updated
        else đã sinh lại / OUTDATED
            API --> Web : 409 / 422 → tải lại shot
        end
    end
end
@enduml
