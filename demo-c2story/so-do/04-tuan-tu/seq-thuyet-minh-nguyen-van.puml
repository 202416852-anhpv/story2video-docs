@startuml Seq_ThuyetMinhNguyenVan
!theme plain
!include _style-tuan-tu.iuml
autonumber
'@sau-mvp
title UC-05.11 (+05.11a) + UC-05.12 + UC-05.13 (+05.13a, 05.13b, 05.13c) + UC-05.14 (+05.14a): Cài đặt giọng, nghe thử đồng bộ,\ntừ điển phát âm, sinh thuyết minh nguyên văn, kiểm chứng WER; BR-18, BR-19, BR-22; ADR-26, ADR-30; QĐ-121..123, QĐ-131, QĐ-140
'@/sau-mvp
'@mvp title UC-05.11 (+05.11a) + UC-05.12 + UC-05.13 (+05.13a, 05.13b) (MVP): Cài đặt giọng, nghe thử đồng bộ,\ntừ điển phát âm, sinh thuyết minh nguyên văn bằng TTS tự host; BR-18, BR-19, BR-22; ADR-26, ADR-30; QĐ-121..123, QĐ-131, QĐ-140

actor Editor $NGUOI_DUNG
participant "Web App" as Web $GIAO_DIEN
box "API Server — module media/narration" $BOX_API
participant "NarrationController\n→ NarrationService" as NS $API
participant "PronunciationService" as PS $API
participant "JobService\n+ WalletService" as JOBS $API
participant "Realtime (SSE)" as RT $API
end box
database PostgreSQL as DB $DU_LIEU
box "Worker" $BOX_WORKER
participant "NarrateSegmentHandler" as W $WORKER
end box
box "AI Gateway" $BOX_AI_GATEWAY
participant "SpeechNormalizer" as N $AI_GATEWAY
participant "TtsPort\n(SelfHostedTtsAdapter)" as TA $AI_GATEWAY
participant "AlignerPort / SttPort\n(WhisperXAlignerAdapter)" as AA $AI_GATEWAY
participant "UsageMeter" as UM $AI_GATEWAY
end box
box "Máy GPU của nhóm" $BOX_BEN_NGOAI
participant "TTS Server\n(model tự host)" as TTS $BEN_NGOAI
participant "Alignment Worker\n(WhisperX)" as AL $BEN_NGOAI
end box
'@sau-mvp
participant "Vbee AIVoice\n(sau MVP)" as VB $BEN_NGOAI
'@/sau-mvp
participant "Object Storage" as S3 $DU_LIEU

== Cài đặt thuyết minh (UC-05.11) và nghe mẫu giọng (UC-05.11a) ==
Editor -> Web : Chọn ngôn ngữ, giọng, tốc độ, nghỉ câu / đoạn,\nbật / tắt quy tắc ký hiệu SYM-01..05
Web -> NS : GET /voices?language → danh mục giọng (TTS tự host: giọng mẫu có quyền dùng)
Editor -> Web : ▶ mẫu có sẵn → phát voices.sample_media_id (miễn phí)
Web -> NS : PUT /projects/{pid}/narration-settings (If-Match)
NS -> DB : narration_settings
alt đã có thuyết minh (4a)
    NS --> Web : 200 {affectedShots, estimatedCostUsd} → hỏi sinh lại toàn bộ
end

== Từ điển phát âm (UC-05.12) + nghe thử đồng bộ, miễn phí (QĐ-131, QĐ-136) ==
Editor -> Web : Thêm mục: từ viết, cách đọc, kiểu, phân biệt hoa thường
Web -> PS : POST /projects/{pid}/pronunciations
PS -> DB : ≤ 500 mục, không trùng từ viết (1a)
alt giọng thuộc TTS tự host (1b)
    PS -> PS : chỉ nhận kind = ALIAS (viết lại cách đọc bằng chữ)
end
PS -> DB : INSERT pronunciation_entries
PS --> Web : 201 + danh sách shot chứa từ (gợi ý sinh lại)
Editor -> Web : Nghe thử câu chứa từ (≤ 200 ký tự)
Web -> PS : POST /projects/{pid}/pronunciations:preview {text}
PS -> PS : rate limit ≤ 10 lần/phút/người (BR-32)
PS -> N : normalize(text, settings, entries)
PS -> PS : cache theo hash(R, giọng, tốc độ)? có → trả audio ngay
PS -> TA : speak(NormalizedSpeech, voice, speed) — timeout 15 s, không thử lại
TA -> TTS : POST /synthesize (HTTP nội bộ)
alt thành công
    TTS --> TA : audio (+ giây GPU)
    PS --> Web : 200 audio/mpeg (cache 24 giờ; không tạo job, không giữ tiền)
else lỗi / quá 15 s
    PS --> Web : 503 → "Thử lại hoặc nghe mẫu có sẵn" (3c)
end

== Sinh thuyết minh (UC-05.13): chương hoặc từng shot ==
Editor -> Web : "Sinh thuyết minh chương" | "Sinh lại" trên shot
Web -> NS : GET …/chapters/{cid}/narrations:quote → {chars, estimatedCostUsd}
Web -> NS : POST …/chapters/{cid}/narrations | …/shots/{shid}/narration:generate\n(Idempotency-Key)
NS -> JOBS : chương: createPaidJob(GENERATE_MEDIA_CHAPTER {parts: [NARRATION]})\n→ con NARRATE_SEGMENT × n, HOLD ở job cha (WR-05); khóa chương (BR-12)\nmột shot: createPaidJob(NARRATE_SEGMENT) là job gốc, HOLD riêng
ref over JOBS, DB : seq-vong-doi-job §2 (402 / 423 / 503)
NS --> Web : 202

loop mỗi NARRATE_SEGMENT (concurrency của queue tts, theo VRAM)
    W -> DB : narrations(GENERATING, version_no + 1)
    group UC-05.13a Cắt đoạn nguồn & kiểm tra hash
        W -> DB : chapters.content; shots.source_start, source_end, source_hash
        W -> W : text = content[start:end] (UTF-16, ADR-26);\nlà nơi **duy nhất** hình thành văn bản đọc
        alt sha256(text) ≠ source_hash (2a)
            W -> DB : narration OUTDATED; job FAILED; dừng
        end
    end
    group UC-05.13b Chuẩn hóa phát âm
        W -> N : normalize(text, symbol_rules, pronunciation_entries, settings)
        N -> N : SYM-01..04: bỏ ký hiệu trình bày, giữ chữ;\nSYM-05 "---" → PAUSE 0,5 s; số, ngày, đơn vị;\nALIAS theo từ điển (PHONEME bỏ qua với TTS tự host, 2b)
        N -> N : sinh R (bản đọc), SSML, NormalizationMap\n(IDENTITY / DROP / EXPAND / ALIAS / PAUSE, 12 §2.2)
        N -> N : kiểm tra ngược: bỏ thẻ, đảo alias → chỉ thiếu ký hiệu\nđã bỏ theo quy tắc đang bật (BR-19)
        N --> W : R, ssml, map, normalization_log
        alt kiểm tra ngược sai (4a)
            W -> DB : narration FAILED; cảnh báo P1; **không gọi TTS**
        else đoạn chỉ có dòng phân cách (1a)
            W -> DB : narration DONE = khoảng lặng 0,5 s, không word_timings,\nkhông phụ đề (BR-22); không gọi TTS
        end
    end
'@sau-mvp
    alt giọng TTS tự host (MVP, ADR-30)
'@/sau-mvp
        W -> TA : speak(NormalizedSpeech, voice, language, speed) (QĐ-145)
        TA -> TA : tách R tại các đoạn PAUSE; đoạn dài chia theo câu
        loop mỗi đoạn
            TA -> TTS : POST /synthesize {text chữ thuần, speaker, speed}\n(timeout ≥ 2× thời lượng dự kiến, QĐ-126)
            TTS --> TA : wav
        end
        TA -> TA : ghép đoạn + chèn khoảng lặng đúng độ dài PAUSE
        opt model không hỗ trợ tham số speed (QĐ-140)
            TA -> TA : FFmpeg atempo = speed (giữ cao độ)\n**trước** căn timestamp, nên timestamp khớp file cuối
        end
        TA -> TA : mã hóa mp3
        TA -> UM : ai_usage_records(unit = SECONDS, giây GPU, QĐ-123)
        TA --> W : audio, duration_ms (không có timestamp)
        W -> S3 : PUT narrations/{id}.mp3
        W -> AA : align(audio, R, language)
        AA -> AL : job con VERIFY_NARRATION (queue align),\nworker Node chờ kết quả (waitUntilFinished)
        AL -> S3 : đọc audio
        AL -> AL : forced alignment trên R (WhisperX; MFA dự phòng)
        AL --> AA : timings trên R (offset code point)
        AA -> AA : code point → code unit UTF-16 (hàm dùng chung, MAP-10)
        AA -> UM : ai_usage_records(SECONDS)
'@sau-mvp
    else giọng Vbee AIVoice (sau MVP)
        W -> TA : speak(NormalizedSpeech, voice) qua VbeeTtsAdapter (dùng speech.ssml)
        TA -> VB : HTTPS (SSML alias / phoneme / break)
        VB --> TA : audio (+ timestamp nếu có) — đơn vị CHARS
        opt không có timestamp đạt EVAL-alignment
            W -> AA : align(audio, R) như nhánh trên
        end
    end
'@/sau-mvp
    alt TTS / aligner lỗi sau retry, CONTENT_POLICY (4a, 5a)
        W -> DB : narration FAILED; **không tự sửa văn bản** (BR-18)
    else
        W -> W : ánh xạ timings trên R → word_timings trên tọa độ chương\nqua NormalizationMap (12 §2.3); từ trong ALIAS / EXPAND\nnhận khoảng thời gian của cả đoạn
'@sau-mvp
        opt sau MVP: kiểm chứng ASR (UC-05.13c)
            W -> AA : transcribe(audio, hint = R)
            AA -> AL : STT
            AL --> AA : transcript
            W -> W : WerScorer: WER theo âm tiết − WER nền (QĐ-111), mismatches[]
            W -> DB : status = VERIFIED (WER ≤ ngưỡng) | NEEDS_REVIEW
        end
'@/sau-mvp
        W -> DB : BEGIN; media_files; narrations(DONE, spoken_text = R, ssml,\nnormalization_log, word_timings, duration_ms, voice_id,\nsource_hash, flagged_at = NULL); shots.current_narration_id
        W -> DB : job SUCCEEDED; [chỉ khi là job gốc] CAPTURE Σ cost × 1,10\n+ RELEASE dư; COMMIT
    end
    W -> RT : narration.updated
end
W -> DB : job cha xong: quyết toán cả lượt (WR-05: CAPTURE chi phí các con thành công,\nRELEASE phần còn lại) + mở khóa chương, cùng một giao dịch
RT --> Web : SSE narration.updated
'@sau-mvp

== Duyệt shot NEEDS_REVIEW (UC-05.14, UC-05.14a, sau MVP) ==
Editor -> Web : Nghe, xem từ tô đỏ theo mismatches
alt thêm từ điển phát âm rồi sinh lại
    Web -> PS : POST /pronunciations
    Web -> NS : POST …/shots/{shid}/narration:generate
else chấp nhận thủ công
    Editor -> Web : Tích "Tôi đã nghe và lời đọc đúng nguyên văn"
    Web -> NS : POST …/shots/{shid}/narration:accept
    alt narration vẫn NEEDS_REVIEW
        NS -> DB : ACCEPTED (accepted_by, accepted_at)
        NS --> Web : 200
        NS -> RT : narration.updated
    else đã sinh lại / OUTDATED
        NS --> Web : 409 | 422 → tải lại shot
    end
end
'@/sau-mvp
@enduml
