@startuml State_NarrationRender
!theme plain
skinparam defaultFontName "Segoe UI"
title Trạng thái thuyết minh (mỗi shot) và bản xuất video

state Narration {
    [*] --> PENDING : shot mới / chưa sinh
    PENDING --> GENERATING : sinh (HOLD credit)
    GENERATING --> VERIFIED : WER <= ngưỡng\n(mặc định 0,03)
    GENERATING --> NEEDS_REVIEW : WER > ngưỡng\n(> 10% luôn cần người duyệt)
    GENERATING --> FAILED : TTS / Aligner / STT lỗi sau retry,\nkiểm tra ngược SSML thất bại,\nvi phạm chính sách (RELEASE)
    NEEDS_REVIEW --> GENERATING : sinh lại (từ điển phát âm / đổi giọng)
    NEEDS_REVIEW --> ACCEPTED : Editor chấp nhận thủ công\n(narration:accept, UC-05.14a)
    FAILED --> GENERATING : thử lại
    VERIFIED --> OUTDATED : đoạn nguồn đổi hash
    ACCEPTED --> OUTDATED : đoạn nguồn đổi hash
    NEEDS_REVIEW --> OUTDATED : đoạn nguồn đổi hash
    OUTDATED --> GENERATING : sinh lại
}

state Render {
    [*] --> QUEUED : readiness OK (coverage 100%)
    QUEUED --> RENDERING
    RENDERING --> READY : encode xong
    RENDERING --> FAILED_R : lỗi encode
    QUEUED --> CANCELLED : hủy
    RENDERING --> CANCELLED : hủy
    READY --> [*]
    FAILED_R --> [*]
    CANCELLED --> [*]
}
note bottom of Render
  Render chỉ được tạo khi mọi shot trên timeline
  có Narration VERIFIED hoặc ACCEPTED (BR-23)
end note
@enduml
