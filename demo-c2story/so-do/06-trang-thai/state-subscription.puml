@startuml State_Subscription
!theme plain
skinparam defaultFontName "Segoe UI"
title Trạng thái Subscription
[*] --> INCOMPLETE : checkout tạo
INCOMPLETE --> ACTIVE : invoice.paid / GRANT credit
INCOMPLETE --> EXPIRED : quá hạn thanh toán lần đầu
ACTIVE --> ACTIVE : gia hạn kỳ / EXPIRE cũ + GRANT mới
ACTIVE --> PAST_DUE : invoice.payment_failed
PAST_DUE --> ACTIVE : thanh toán lại thành công
PAST_DUE --> CANCELED : hết thời gian ân hạn
ACTIVE --> CANCEL_AT_PERIOD_END : người dùng hủy
CANCEL_AT_PERIOD_END --> ACTIVE : bỏ hủy
CANCEL_AT_PERIOD_END --> CANCELED : hết kỳ / EXPIRE credit subscription
CANCELED --> [*]
EXPIRED --> [*]
@enduml
