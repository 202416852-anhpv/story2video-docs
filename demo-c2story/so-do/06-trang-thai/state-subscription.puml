@startuml State_Subscription
!theme plain
skinparam defaultFontName "Segoe UI"
title Trạng thái Subscription (sau MVP)
[*] --> INCOMPLETE : checkout tạo
INCOMPLETE --> ACTIVE : checkout.session.completed /\ninvoice.paid
INCOMPLETE --> EXPIRED : quá hạn thanh toán lần đầu
ACTIVE --> ACTIVE : gia hạn kỳ / EXPIRE cũ + GRANT mới
ACTIVE --> PAST_DUE : invoice.payment_failed\n(gửi email nhắc)
ACTIVE --> CANCELED : customer.subscription.deleted
PAST_DUE --> ACTIVE : thanh toán lại thành công
PAST_DUE --> CANCELED : hết thời gian ân hạn
ACTIVE --> CANCEL_AT_PERIOD_END : người dùng hủy
CANCEL_AT_PERIOD_END --> ACTIVE : bỏ hủy
CANCEL_AT_PERIOD_END --> CANCELED : hết kỳ
CANCELED --> [*]
EXPIRED --> [*]
@enduml
