@startuml UC_M05a_Storyboard_MVP
' Sinh tự động bởi so-do/tools/gen_mvp.py - không sửa tay
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 10
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #F5F7FA
    BorderColor #37474F
}
skinparam rectangle {
    BorderColor #37474F
}
left to right direction
title M05a - Storyboard (chạy tự động trong "Sinh tư liệu", tinh chỉnh tùy chọn) (MVP)

actor "Editor" as Editor

rectangle "M05 Sinh tư liệu - phần Storyboard" {
    usecase "UC-05.01\nTạo bản nháp storyboard" as UC1
    usecase "UC-05.01a\nTách câu & kiểm tra phủ kín" as UC1a
    usecase "UC-05.02c\nĐặt bản nháp hiện hành" as UC2c
    usecase "UC-05.03\nChia lại shot (nhiều / ít hơn)" as UC3
    usecase "UC-05.06\nBiên tập shot" as UC6
    usecase "UC-05.06a\nSửa brief, thời điểm, caption" as UC6a
    usecase "UC-05.06b\nGắn cast / item / location" as UC6b
    usecase "UC-05.06c\nTách / gộp / xóa shot" as UC6c
    usecase "UC-05.06e\nViết lại brief một shot bằng\nAI" as UC6e
    usecase "UC-05.06f\nTự khớp tên với tài sản" as UC6f
}
rectangle "LLM Provider" as LLM

Editor --> UC1
Editor --> UC3
Editor --> UC6
UC1 ..> UC1a : <<include>>
UC3 ..> UC1a : <<include>>
UC6c ..> UC1a : <<include>>
UC6 <.. UC6a : <<extend>>
UC6 <.. UC6b : <<extend>>
UC6 <.. UC6c : <<extend>>
UC6 <.. UC6e : <<extend>>
UC6 <.. UC6f : <<extend>>
UC1 --> LLM
UC6e --> LLM
@enduml
