@startuml UC_M06_Editor_MVP
' Sinh tự động bởi so-do/tools/gen_mvp.py - không sửa tay
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 10
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #F5F7FA
    BorderColor #37474F
}
skinparam rectangle {
    BorderColor #37474F
}
left to right direction
title M06 - Trình chỉnh sửa & xuất video (MVP)

actor "Editor" as Editor

rectangle "M06 Trình chỉnh sửa & xuất video" {
    usecase "UC-06.01\nMở trình chỉnh sửa" as UC1
    usecase "UC-06.01a\nDựng bản nháp timeline\ntừ tư liệu" as UC1a
    usecase "UC-06.02\nThao tác timeline" as UC2
    usecase "UC-06.02a\nKiểm tra khóa thuyết minh" as UC2a
    usecase "UC-06.03\nQuản lý track" as UC3
    usecase "UC-06.04\nĐặt hiệu ứng Ken Burns &\nđiểm tập trung" as UC4
    usecase "UC-06.05\nĐặt chuyển cảnh" as UC5
    usecase "UC-06.06\nChọn khung hình & tinh chỉnh\nmàu" as UC6
    usecase "UC-06.08\nĐịnh kiểu phụ đề" as UC8
    usecase "UC-06.09\nThêm nhạc nền" as UC9
    usecase "UC-06.10\nThêm SFX" as UC10
    usecase "UC-06.11\nTìm trong thư viện âm thanh" as UC11
    usecase "UC-06.11a\nTải nhạc / SFX lên" as UC11a
    usecase "UC-06.13\nXem trước" as UC13
    usecase "UC-06.15\nĐồng bộ khi tư liệu thay đổi" as UC15
    usecase "UC-06.16\nXuất video MP4" as UC16
    usecase "UC-06.16a\nKiểm tra điều kiện\n& độ phủ 100%" as UC16a
    usecase "UC-06.17\nTải MP4 / SRT / audio" as UC17
}
rectangle "Render Worker" as RW

Editor --> UC1
Editor --> UC2
Editor --> UC3
Editor --> UC4
Editor --> UC5
Editor --> UC6
Editor --> UC8
Editor --> UC9
Editor --> UC10
Editor --> UC13
Editor --> UC16
Editor --> UC17
UC1 ..> UC1a : <<include>>
UC1 <.. UC15 : <<extend>>
UC2 ..> UC2a : <<include>>
UC9 ..> UC11 : <<include>>
UC10 ..> UC11 : <<include>>
UC11 <.. UC11a : <<extend>>
UC16 ..> UC16a : <<include>>
UC16 --> RW
note right of UC6
  Nhánh *a: bật/tắt vùng an toàn và lưới căn chỉnh (chỉ khi chỉnh sửa, không vào video xuất)
end note
note right of UC8
  Có preset dựng sẵn (hằng số dùng chung, không lưu DB)
  Phụ đề hiện nguyên ký hiệu trình bày (BR-22)
end note
note right of UC2
  Clip thuyết minh: chỉ dời, chỉnh âm lượng (BR-24);
  tốc độ đọc đặt cho cả dự án (UC-05.11)
end note
@enduml
