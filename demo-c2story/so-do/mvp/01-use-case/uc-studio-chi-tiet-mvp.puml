@startuml UC_Studio_ChiTiet_MVP
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 10
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #F5F7FA
    BorderColor #37474F
}
skinparam packageStyle rectangle
left to right direction
title Studio dự án - use case chính (MVP)

actor "Owner" as Owner

rectangle "Studio dự án (MVP)" {
    package "M02 Dự án" as P2 {
        usecase "UC-02.02 Import truyện" as UC02
        usecase "UC-02.04 Cài đặt dự án" as UCset
        usecase "UC-02.09 Xem Map (✂1)" as UCmap
    }
    package "M03 Bản thảo" as P3 {
        usecase "UC-03.03 Chia chương" as UC05
        usecase "UC-03.02a Dời ranh giới shot" as UC05a
    }
    package "M04 Thế giới truyện" as P4 {
        usecase "UC-04.01 Story Assets" as UC07
        usecase "UC-04.10 Visual Rules" as UC08
        usecase "Timeline (✂4) & Relationships (✂3)" as UCtl
    }
    package "M05 Sinh tư liệu" as P5 {
        usecase "UC-05.07 Sinh tư liệu chương" as UC11
        usecase "UC-05.01 Storyboard\n(tự động, tinh chỉnh tùy chọn)" as UC09
        usecase "UC-05.09 Sinh & sửa ảnh" as UC10
        usecase "UC-05.13 Thuyết minh nguyên văn" as UC12
        usecase "UC-05.18 Nghe & đánh dấu" as UC18
    }
    package "M06 Trình chỉnh sửa & xuất video" as P6 {
        usecase "UC-06.01 Chỉnh sửa video trên timeline\n(chuyển cảnh, nhạc nền, SFX, tốc độ đọc)" as UC13
        usecase "UC-06.16 Xuất & tải video" as UC14
    }
}

Owner --> P2
Owner --> P3
Owner --> P4
Owner --> P5
Owner --> P6
UC11 ..> UC09 : <<include>>
UC11 ..> UC10 : <<include>>
UC11 ..> UC12 : <<include>>
UC14 ..> UC13 : <<include>>

legend right
  **Phụ thuộc giữa các gói** (<<include>>)
  • M05 dùng tài sản của M04 (giữ nhất quán)
  • M06 dựng video từ ảnh + thuyết minh của M05
  • ✂n: vị trí trong thứ tự cắt giảm (QĐ-05)
endlegend
@enduml
