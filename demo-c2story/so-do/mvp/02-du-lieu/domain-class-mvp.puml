@startuml Domain_StoryStudio_MVP
' Sinh tự động bởi so-do/tools/gen_mvp.py - không sửa tay
' Mô hình miền (Domain Model) - các khái niệm nghiệp vụ và quan hệ, không phải schema vật lý
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam classAttributeIconSize 0
hide empty methods
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

package "Định danh & Thanh toán" #EEF5FF {
    class User #D6E8FF {
        email
        displayName
        locale
        consentedAt
        consentVersion
    }
    class BetaInvite #D6E8FF {
        email
        revokedAt
    }
    class Wallet #D6E8FF {
        availableMicro
        heldMicro
        topupTotalMicro
        +isPaid() : topupTotal > 0
        +grantTrial($2)
        +topup(amount)
        +hold(estimate, job)
        +capture(actualCost × 1,10, job)
        +release(job)
    }
}

package "Dự án" #F3FFF0 {
    class Project #DCF5D2 {
        title
        style
        imageModel
        language
        targetShotSeconds
        aspectRatio
        artDirection
        workflowStep : 1..6
        +importSource(text)
    }
    class Membership #DCF5D2 {
        role : OWNER | EDITOR
    }
    class SourceText #DCF5D2
    class Chapter #DCF5D2 {
        order
        title
        content
        mediaStatus
        version
        +split(at)
        +mergeIntoPrevious()
        +moveBoundary(delta)
    }
}

package "Thế giới truyện" #FFF8E8 {
    abstract class StoryAsset #FFE9BF {
        name
        aliases
        appearance
        facts
        +generateReference()
    }
    class Character #FFE9BF
    class Location #FFE9BF
    class Prop #FFE9BF
    class Group #FFE9BF
    class VisualRule #FFE9BF {
        instruction
        scope
    }
    class TimelineEvent #FFE9BF {
        dayLabel
        season
    }
    class Relationship #FFE9BF {
        label
        dynamic
    }
}

package "Sinh tư liệu" #F5EEFF {
    class StoryboardDraft #E6D8FF {
        name
        isCurrent
        +resplit(more|fewer)
    }
    class Shot #E6D8FF {
        sourceStart
        sourceEnd
        sourceHash
        title
        focus
        time
        date
        brief
        caption
        +rewrite(note)
        +generateImage()
    }
    class Illustration #E6D8FF {
        version
        status
        +edit(prompt)
    }
    class NarrationSettings #E6D8FF {
        voice
        language
        speed
        symbolRules
    }
    class PronunciationEntry #E6D8FF {
        written
        spoken
    }
    class Narration #E6D8FF {
        sourceHash
        wordTimings
        status : DONE|FAILED|OUTDATED…
        flaggedAt
        +flag() / +unflag()
    }
}

package "Trình chỉnh sửa video" #FFEFEF {
    class Timeline #FFD6D6 {
        scope : CHAPTER (PROJECT: sau MVP)
        aspectRatio
        framing
        subtitleStyle
        version
        +applyOps(ops)
        +syncMedia()
        +readiness() : Report
    }
    class Track #FFD6D6 {
        kind : VIDEO|OVERLAY|SUBTITLE|NARRATION|MUSIC|SFX
        locked
        muted
        volume
    }
    class TimelineItem #FFD6D6 {
        kind : IMAGE|NARRATION|TITLE|TEXT|AUDIO
        startMs
        durationMs
        motion
        transitionIn
        volume
        duckingDb
    }
    class AudioAsset #FFD6D6 {
        kind : MUSIC|SFX
        license
    }
    class Render #FFD6D6 {
        scope : CHAPTER|PROJECT
        versionNo
        partNo
        watermark
        coverage
        timelineSnapshot
    }
}

package "Tự động hóa" #EAF7F7 {
    class Job #CDEDED {
        type
        status
        heldMicro
        chargedMicro
        attempts
    }
}

User "1" -- "1" Wallet
User "0..1" -- "0..1" BetaInvite : được mời
User "1" -- "*" Membership
Project "1" *-- "1..*" Membership
Project "1" *-- "1..*" SourceText
Project "1" *-- "*" Chapter
Project "1" *-- "*" StoryAsset
Project "1" *-- "*" VisualRule
Project "1" *-- "1" NarrationSettings
Project "1" *-- "*" PronunciationEntry
Project "1" *-- "*" Timeline
StoryAsset <|-- Character
StoryAsset <|-- Location
StoryAsset <|-- Prop
StoryAsset <|-- Group
Group o-- "2..*" Character
Relationship "*" --> "2" Character
Chapter "1" *-- "0..1" TimelineEvent
Chapter "1" *-- "*" StoryboardDraft
StoryboardDraft "1" *-- "1..*" Shot
Shot "*" --> "*" StoryAsset
Shot "1" *-- "*" Illustration
Shot "1" *-- "*" Narration : verbatim(source) >
Timeline "1" *-- "1..*" Track
Track "1" *-- "*" TimelineItem
TimelineItem "*" --> "0..1" Shot
TimelineItem "*" --> "0..1" Illustration : ảnh
TimelineItem "*" --> "0..1" Narration : thuyết minh (khóa)
TimelineItem "*" --> "0..1" AudioAsset : nhạc / SFX
Project "1" *-- "*" Render
Timeline "0..1" o-- "*" Render : CHAPTER

' Bố cục lưới: hàng 1 Identity | Project | Automation ; hàng 2 Story World | Sinh tư liệu | Trình chỉnh sửa
User -[hidden]right- Project
Chapter -[hidden]down- StoryboardDraft
StoryAsset -[hidden]right- StoryboardDraft
Shot -[hidden]right- Timeline

legend right
  **Phụ thuộc không vẽ để đỡ rối**
  • Job giữ giá ước tính / trừ chi phí thực × 110% / hoàn phần dư trên Wallet
  • Màu theo nhóm nghiệp vụ, cùng bảng màu với ERD (erd.puml)
  • Job sinh ra Illustration, Narration, Render
endlegend
@enduml
