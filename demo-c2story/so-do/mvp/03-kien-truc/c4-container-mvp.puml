@startuml C4_Container_MVP
!include <C4/C4_Container>
title AI Story Studio - Containers (C4 L2) - MVP
LAYOUT_TOP_DOWN()

Person(user, "Owner")
Person(admin, "Admin")

System_Boundary(sys, "AI Story Studio") {
    Container(web, "Web App", "Next.js, React, Zustand, Remotion Player, WebAudio", "Studio, trình chỉnh sửa timeline + preview, media bin, ví, màn hình đồng ý dữ liệu")
    Container(api, "API Server", "NestJS, TS", "BFF/OIDC, danh sách mời, authz, nghiệp vụ, BudgetGuard + HOLD, enqueue sau commit, webhook, SSE")
        Container(worker, "Worker (một tiến trình, ADR-23)", "Node.js, BullMQ Flows", "Mọi queue: orchestrator, llm, image, tts, media-proc (quét virus, chuyển mã, waveform, đổi tốc độ audio); job lặp: reconciler, cảnh báo trần ngày; quyết toán chi phí thực × 110%")
    Container(tts, "TTS Server (tự host)", "Python, model TTS mã nguồn mở, GPU", "Bản đọc chữ thuần → audio; HTTP nội bộ (ADR-30)")
    Container(align, "Alignment Worker", "Python, WhisperX/MFA, GPU", "align: word timings cho audio của TTS tự host (QĐ-122)")
    Container(render, "Render Worker", "Remotion + FFmpeg", "render: timeline_snapshot → MP4, SRT/VTT; watermark Free")
    Container(gw, "AI Gateway", "Thư viện nội bộ", "Adapter thật + mock, PriceEstimator, prompt compiler, speech normalizer (ký hiệu SYM), coverage validator, moderation, usage")
    Container(cli, "Admin CLI / seed", "Node.js", "pnpm seed (giá, provider, style, giọng, system_settings); pnpm admin:invites")
    ContainerDb(db, "PostgreSQL", "16", "Nghiệp vụ, ví + sổ cái, beta_invites, outbox, idempotency, audit")
    ContainerDb(redis, "Redis", "7", "Queue, pub/sub, rate limit, cache")
    ContainerDb(s3, "Object Storage", "S3/R2/MinIO + CDN", "Ảnh, audio, video, nhạc & SFX tải lên")
}

System_Ext(sso, "SSO", "Keycloak / SSO Vbee")
System_Ext(pay, "Stripe (test mode)")
System_Ext(ai, "Google Gemini", "LLM, Image")
System_Ext(mail, "Email")

Rel(user, web, "Dùng", "HTTPS")
Rel(admin, cli, "Chạy lệnh")
Rel(cli, db, "Seed, danh sách mời", "SQL")
Rel(user, sso, "Đăng nhập (redirect)", "HTTPS")
Rel(web, api, "REST, apply-ops, SSE", "HTTPS")
Rel(web, s3, "Tải media", "Signed URL / CDN")
Rel(api, sso, "Token, JWKS / userinfo, end_session", "OIDC / OAuth 2.0")
Rel(pay, api, "Webhook", "HTTPS")
Rel(api, db, "Đọc/ghi + outbox", "SQL")
Rel(api, redis, "Pub/Sub, rate limit", "RESP")
Rel(api, gw, "Giá ước tính")
Rel(worker, mail, "Cảnh báo Admin", "API")
Rel(worker, redis, "Consume", "RESP")
Rel(worker, db, "Kết quả, sổ cái, outbox", "SQL")
Rel(worker, gw, "Gọi")
Rel(worker, s3, "Lưu ảnh, audio", "S3 API")
Rel(align, redis, "Consume align", "RESP")
Rel(align, db, "word_timings", "SQL")
Rel(align, s3, "Đọc audio", "S3 API")
Rel(render, redis, "Consume render", "RESP")
Rel(render, db, "renders", "SQL")
Rel(render, s3, "Đọc media, ghi MP4", "S3 API")
Rel(gw, ai, "Gọi API (mock ở dev/CI)", "HTTPS")
Rel(gw, tts, "Tổng hợp giọng (mock ở dev/CI)", "HTTP nội bộ")
@enduml
