@startuml C4_Context_MVP
!include <C4/C4_Context>
title AI Story Studio - System Context (C4 L1) - MVP / closed beta

Person(editor, "Owner (người dùng beta được mời)", "Tác giả chuyển truyện thành video minh họa")
Person(admin, "Admin", "Danh sách mời (CLI), file cấu hình seed, nhận cảnh báo trần chi tiêu")

System(studio, "AI Story Studio", "6 bước: nhập truyện → chia chương → thế giới truyện → sinh tư liệu (ảnh + thuyết minh nguyên văn) → chỉnh sửa video (nhạc nền, SFX) → xuất & tải")

System_Ext(sso, "SSO", "Keycloak tự dựng; SSO Vbee trước khi bảo vệ - đăng ký, đăng nhập, đăng xuất, MFA (không phát triển lại)")
System_Ext(pay, "Stripe (test mode)", "Checkout nạp tiền (sandbox), webhook")
System_Ext(llm, "Google Gemini (LLM)", "Chia chương, phân tích, storyboard, viết lại brief")
System_Ext(img, "Google Gemini Image", "Sinh và sửa ảnh có tham chiếu")
System_Ext(tts, "TTS Server (tự host)", "Model TTS mã nguồn mở trên máy GPU của nhóm; giọng đọc nguyên văn")
System_Ext(stt, "Aligner / STT (WhisperX tự host)", "Timestamp từng từ; cùng máy GPU với TTS Server")
System_Ext(mail, "Email Service", "Cảnh báo trần chi tiêu cho Admin, thông báo xuất video")
System_Ext(store, "Object Storage + CDN", "S3 / R2 / MinIO")

Rel(editor, studio, "Dùng", "HTTPS")
Rel(admin, studio, "Quản trị", "CLI / seed")
Rel(editor, sso, "Đăng nhập", "HTTPS")
Rel(studio, sso, "Xác thực, logout", "OIDC / OAuth 2.0")
Rel(studio, pay, "Checkout, nhận webhook", "HTTPS")
Rel(studio, llm, "Gọi", "HTTPS")
Rel(studio, img, "Sinh ảnh", "HTTPS")
Rel(studio, tts, "Sinh thuyết minh", "HTTP nội bộ (WireGuard)")
Rel(studio, stt, "Căn timestamp", "HTTP nội bộ (WireGuard)")
Rel(studio, mail, "Gửi email", "API")
Rel(studio, store, "Lưu media", "S3 API")
@enduml
