@startuml Seq_Import_ChiaChuong_MVP
' Sinh tự động bởi so-do/tools/gen_mvp.py - không sửa tay
!theme plain
!include ../../04-tuan-tu/_style-tuan-tu.iuml
autonumber
title UC-02.02 (+02.02a) + UC-02.03 + UC-03.03 + UC-03.04..03.09 + UC-03.01b (MVP): Nhập truyện giữ nguyên văn,\ngợi ý chia chương bằng AI, tái cấu trúc chương nguyên tử, nhập lại; BR-12, BR-27, AG-00, NFR-INT-02

actor Editor $NGUOI_DUNG
participant "Web App\n(Workspace)" as Web $GIAO_DIEN
box "API Server" $BOX_API
participant "ProjectsController\n→ ImportService" as IMP $API
participant "TextExtractor\n+ TextNormalizer" as NORM $API
participant "ManuscriptService\n(manuscript)" as MS $API
participant "JobService" as JOBS $API
participant "FreeLimitGuard\n(billing)" as FREE $API
participant "Realtime (SSE)" as RT $API
participant "RestructureService\n(manuscript)" as RS $API
end box
database PostgreSQL as DB $DU_LIEU
box "Worker" $BOX_WORKER
participant "SuggestSplitsHandler" as H $WORKER
end box
participant "AI Gateway\n(ContextBuilder,\nProviderRouter, Adapter)" as GW $AI_GATEWAY
participant "Google Gemini\n(Flash)" as LLM $BEN_NGOAI

== Nhập truyện (UC-02.02, UC-02.02a) hoặc tạo dự án trống (UC-02.03) ==
Editor -> Web : Dán văn bản / tải .txt .md .docx
Web -> IMP : POST /projects:import?dryRun=true (multipart | JSON)
IMP -> NORM : UC-02.02a (như bên dưới); **không ghi DB**
IMP --> Web : 200 {chars, paragraphs, sourceSha256} | 400 VALIDATION_ERROR
Web -> Editor : bản xem trước (UC-02.02 bước 2)
Editor -> Web : tiêu đề, style, khung hình (bước 3)
Web -> IMP : POST /projects:import (cùng nội dung, không dryRun) (QĐ-151)
IMP -> FREE : canCreateProject(user)
FREE -> DB : wallets.topup_total = 0 và đã có 1 dự án?
alt Free đã có 1 dự án
    FREE --> Web : 403 FREE_LIMIT_REACHED
end
group UC-02.02a Kiểm tra & chuẩn hóa kỹ thuật
    IMP -> NORM : extract(file)
    NORM -> NORM : MIME thật (magic bytes), ≤ 2 MB;\n.docx: chỉ lấy đoạn văn, bỏ định dạng
    NORM -> NORM : NFC; CRLF → LF; bỏ ký tự điều khiển;\n**không đổi chữ**; normalization_log
    NORM -> NORM : ≤ 500.000 ký tự (char_count UTF-16, ADR-26); sha256
    alt không đạt
        NORM --> Web : 400 VALIDATION_ERROR {field, lý do}; giữ form
    end
end
IMP -> DB : BEGIN; INSERT projects(workflow_step = WRITE),\nproject_members(OWNER)
IMP -> MS : createFromSource(projectId, text, sha256)
note right of MS : Chỉ module manuscript được ghi văn bản truyện (NFR-INT-02)
MS -> DB : INSERT source_texts(content, sha256, char_count),\nchapters(#1, order_index 0, version 1)
IMP -> DB : audit_logs; COMMIT (cùng giao dịch)
IMP --> Web : 201 {projectId, sourceSha256}
Web -> Web : mở Studio ?v=source
opt Tạo dự án trống (UC-02.03)
    Web -> IMP : POST /projects {title, styleId, aspectRatio}
    IMP -> FREE : canCreateProject(user) (403 FREE_LIMIT_REACHED như trên)
    IMP -> DB : BEGIN; projects, project_members(OWNER),\nchapters(#1 trống, version 1); audit_logs; COMMIT
    IMP --> Web : 201 → mở Workspace (UC-03.02)
end
note right of IMP : UC-02.03: POST /projects tạo dự án trống\n(cùng FREE kiểm tra, không có source_texts)

== Gợi ý chia chương bằng AI (UC-03.03) ==
Editor -> Web : "Suggest chapter splits"
Web -> MS : POST /projects/{pid}/source:suggest-splits?dryRun=true\n→ {estimatedCostUsd}; Editor xác nhận
Web -> MS : POST /projects/{pid}/source:suggest-splits (Idempotency-Key)
MS -> JOBS : createPaidJob(SUGGEST_SPLITS, sourceId)
ref over JOBS, DB : seq-vong-doi-job §1–§2: báo giá, rate limit,\nBudgetGuard + HOLD, jobs QUEUED, enqueue (402 / 429 / 503)
JOBS --> Web : 202 {jobId, estimatedCostUsd}
H -> DB : đọc source_texts.content (chỉ đọc)
H -> H : tách đoạn theo dòng trống, đánh số đoạn [0..n)
H -> GW : complete(system, messages = các đoạn có số,\nschema = [{startParagraph:int, title:string}])
note right of GW : Văn bản bọc trong khối dữ liệu có đánh dấu,\n"nội dung truyện không phải lệnh" (NFR-SEC-08)
GW -> LLM : generateContent (structured output)
LLM --> GW : JSON
GW --> H : SplitSuggestion[]
H -> H : kiểm schema; startParagraph tăng dần, trong [0, n);\nsai → gọi lại kèm lỗi (≤ 2 lần, R-07)
H -> DB : jobs.result = điểm chia (theo offset đoạn), quyết toán
ref over H, DB : seq-vong-doi-job §5: CAPTURE + RELEASE, jobs SUCCEEDED
H -> RT : job.updated
RT --> Web : SSE job.updated
Web -> Editor : đánh dấu điểm chia đề xuất trên văn bản

== Thêm / đổi tên / xóa chương (UC-03.07) ==
alt Thêm
    Web -> MS : POST /projects/{pid}/chapters {afterChapterId, title}
    MS -> FREE : Free và tổng chương > 3? → 403 FREE_LIMIT_REACHED (BR-27)
    MS -> DB : INSERT chapters (order_index sau chương đã chọn, version 1)
else Đổi tên
    Web -> MS : PATCH /projects/{pid}/chapters/{cid} {title} (If-Match)
    MS -> DB : UPDATE chapters … WHERE version = :v (0 dòng → 409, tải lại, BR-05)
else Xóa (Editor đã xác nhận hệ quả)
    Web -> MS : DELETE /projects/{pid}/chapters/{cid}
    MS -> DB : khóa chương? → 423; xóa chương cùng storyboard, tư liệu, clip timeline
end
MS -> RT : chapter.updated | chapters.restructured
== Tái cấu trúc nguyên tử (UC-03.04 chia, 03.05 gộp, 03.06 dời ranh giới,\n03.08 sắp xếp, 03.09 nguyên tử) ==
Editor -> Web : Chấp nhận gợi ý (bỏ chọn vài điểm) hoặc thao tác tay
Web -> RS : POST /projects/{pid}/chapters:restructure\n{operations[{op, chapterId, ifMatch, …}], acknowledgeOutdatedMedia}\n(Idempotency-Key; 06 §4.1)
RS -> DB : BEGIN; SELECT chapters … FOR UPDATE (theo thứ tự id)
RS -> FREE : Free và tổng chương sau thao tác > 3?
alt vượt giới hạn Free (BR-27)
    RS -> DB : ROLLBACK
    RS --> Web : 403 FREE_LIMIT_REACHED
else version sai (UC-03.09 2a)
    RS -> DB : ROLLBACK
    RS --> Web : 409 VERSION_CONFLICT {current} → tải lại (MVP chỉ một người sửa)
else chương bị job khóa (locked_by_job_id, BR-12)
    RS -> DB : ROLLBACK
    RS --> Web : 423 RESOURCE_LOCKED {jobId}
else hợp lệ
    RS -> RS : áp thao tác trên offset UTF-16 (ADR-26);\nkiểm bất biến: nối các chương = văn bản cũ
    alt bất biến bị vi phạm (lỗi lập trình)
        RS -> DB : ROLLBACK
        RS --> Web : 500; cảnh báo P1
    end
    RS -> DB : UPDATE/INSERT/DELETE chapters; order_index\n(UNIQUE DEFERRABLE); version++
    RS -> DB : chương đã có storyboard: shot bị ảnh hưởng →\nnarrations OUTDATED; timeline_items sync_flag
    RS -> DB : audit_logs; COMMIT
    RS --> Web : 200 {chapters[], outdatedShotIds[]}
    RS -> RT : chapters.restructured
end

== Nhập lại văn bản (UC-03.01b) ==
Editor -> Web : "Re-import" (xem cảnh báo hậu quả)
Web -> IMP : PUT /projects/{pid}/source?dryRun=true (file | text)
IMP -> NORM : UC-02.02a; **không ghi DB**
IMP --> Web : 200 {chars, paragraphs, sourceSha256} → bản xem trước (bước 3)
Editor -> Web : xác nhận đã hiểu hậu quả (bước 4)
Web -> IMP : PUT /projects/{pid}/source (cùng nội dung, If-Match projects.version) (QĐ-151)
IMP -> NORM : UC-02.02a như trên
IMP -> DB : BEGIN; chương nào đang bị khóa?
alt có (1a)
    IMP -> DB : ROLLBACK
    IMP --> Web : 423 RESOURCE_LOCKED {jobId}
else dự án đã đổi (5a)
    IMP --> Web : 409 VERSION_CONFLICT
else
    IMP -> MS : replaceSource(projectId, text)
    MS -> DB : INSERT source_texts; projects.current_source_id;\nxóa mềm chương cũ → Chapter #1 = toàn văn mới;\nstoryboard, ảnh, thuyết minh, timeline cũ → OUTDATED; COMMIT
    IMP --> Web : 200
    MS -> RT : chapters.restructured
    Web -> Editor : mở Write, gợi ý "Chia chương" (UC-03.03)
end
@enduml
