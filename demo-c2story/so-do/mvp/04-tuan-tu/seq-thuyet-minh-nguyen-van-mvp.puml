@startuml Seq_ThuyetMinhNguyenVan_MVP
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam sequenceMessageAlign left
autonumber
title UC-05.13 (MVP): Sinh thuyết minh nguyên văn (BR-19)
actor Editor
participant "Web App" as Web
participant "API" as API
database PostgreSQL as DB
participant "TTS Worker" as W
participant "SpeechNormalizer" as N
participant "TTS Provider" as TTS
participant "Alignment Worker\n(Aligner)" as AL
participant "Object Storage" as S3

Editor -> Web : "Sinh thuyết minh chương 1"
Web -> API : GET .../narrations:quote
API -> DB : SUM(source_end - source_start) các shot hiện hành
API --> Web : {chars: 9895, estimatedCostUsd}
Editor -> Web : Xác nhận
Web -> API : POST .../chapters/{cid}/narrations (Idempotency-Key)
API -> DB : BudgetGuard (BR-29); HOLD giá ước tính;\njobs NARRATE_CHAPTER + NARRATE_SEGMENT × n; khóa chương (BR-12)
API --> Web : 202

loop mỗi shot (song song có giới hạn)
    W -> DB : UC-05.13a: đọc chapter.content, shot.source_start/end/hash
    W -> W : text = content[start:end]
    alt sha256(text) != shot.source_hash
        W -> DB : narration OUTDATED; RELEASE phần của shot
    else khớp
        W -> N : UC-05.13b: text + symbol_rules + pronunciation_entries + settings
        N --> W : SSML: bỏ ký hiệu trình bày, giữ chữ (SYM-01..04),\n"---" → lặng 0,5 s (SYM-05); break / alias / phoneme\n+ normalization_log
        note right of N
          Kiểm tra ngược: bỏ thẻ SSML và áp ngược alias
          → chỉ thiếu các ký hiệu đã bỏ theo quy tắc
          đang bật (BR-19)
        end note
        alt kiểm tra ngược thất bại
            W -> DB : narration FAILED; RELEASE; cảnh báo P1
        else đoạn chỉ có dòng phân cách
            W -> DB : narration DONE = khoảng lặng 0,5 s, không phụ đề
        else đạt
            W -> TTS : speak(SSML, voice, speed)\n(chia theo câu nếu dài; retry khi lỗi tạm thời)
            alt TTS lỗi sau retry / vi phạm chính sách
                W -> DB : narration FAILED; RELEASE (không tự sửa văn bản, BR-18)
            else audio hợp lệ
                TTS --> W : audio (+ timestamp nếu có) + usage
                W -> S3 : PUT narration.mp3
                W -> W : word_timings = timestamp của TTS (nếu có)
                alt TTS không trả timestamp
                    W -> AL : align(audio, text)
                    AL --> W : word_timings (lỗi sau retry → FAILED, RELEASE)
                end
                W -> DB : narrations(DONE, word_timings), flagged_at = NULL
                W -> DB : CAPTURE chi phí thực × 110%; RELEASE phần dư
            end
        end
    end
    W --> Web : SSE narration.updated
end
W -> DB : mở khóa chương

opt Nghe & đánh dấu (UC-05.18, không bắt buộc trước khi xuất)
    Editor -> Web : Nghe (tô sáng theo word_timings), "Đánh dấu cần sinh lại"
    Web -> API : POST .../narration:flag
    Editor -> Web : Thêm từ điển phát âm (UC-05.12) rồi "Sinh lại shot đã đánh dấu"
    Web -> API : POST /media:generate {only: FLAGGED, parts: [NARRATION]}
end
note over Editor, S3
  MVP không kiểm chứng WER từng shot; WER ≤ 3% được bảo đảm ở khâu
  chọn provider (EVAL-wer-golden, P0) (QĐ-54).
end note
@enduml
