{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-studio.local/schemas/timeline-snapshot.schema.json",
  "title": "timeline_snapshot",
  "description": "Ảnh chụp bất biến, tự đủ của một phiên bản timeline; đầu vào duy nhất của Render Worker. Xem tai-lieu/12-dac-ta-ky-thuat-loi.md §3. Ràng buộc ngoài schema: SNP-01..07.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "scope",
    "output",
    "framing",
    "subtitleStyle",
    "master",
    "coverage",
    "tracks",
    "subtitles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "timelineId": {
      "$ref": "#/$defs/uuid"
    },
    "timelineVersion": {
      "type": "integer",
      "minimum": 1
    },
    "projectId": {
      "$ref": "#/$defs/uuid"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "chapterIds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CHAPTER",
            "PROJECT"
          ]
        },
        "chapterIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspectRatio",
        "width",
        "height",
        "fps",
        "watermark"
      ],
      "properties": {
        "aspectRatio": {
          "enum": [
            "16:9",
            "9:16",
            "1:1"
          ]
        },
        "width": {
          "enum": [
            720,
            1080,
            1280,
            1920
          ]
        },
        "height": {
          "enum": [
            720,
            1080,
            1280,
            1920
          ]
        },
        "fps": {
          "const": 30
        },
        "watermark": {
          "type": "boolean",
          "description": "true khi tài khoản ở trạng thái Free lúc chụp (BR-27)"
        }
      }
    },
    "framing": {
      "enum": [
        "CROP",
        "FIT",
        "BLUR"
      ]
    },
    "subtitleStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "fontFamily",
        "fontSizePx",
        "color",
        "position"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "fontSizePx": {
          "type": "integer",
          "minimum": 12,
          "maximum": 120
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "outlineColor": {
          "$ref": "#/$defs/color"
        },
        "background": {
          "oneOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "const": "NONE"
            }
          ]
        },
        "position": {
          "enum": [
            "BOTTOM",
            "MIDDLE",
            "TOP"
          ]
        },
        "marginPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "master": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loudnessLufs"
      ],
      "properties": {
        "loudnessLufs": {
          "type": "number",
          "minimum": -30,
          "maximum": -8
        },
        "volume": {
          "$ref": "#/$defs/volume"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "covered",
        "total"
      ],
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      }
    },
    "sourceTimelines": {
      "type": "array",
      "minItems": 1,
      "description": "Xuất cả dự án (QĐ-141): timeline và phiên bản của từng chương đã ghép",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chapterId",
          "timelineId",
          "timelineVersion"
        ],
        "properties": {
          "chapterId": {
            "$ref": "#/$defs/uuid"
          },
          "timelineId": {
            "$ref": "#/$defs/uuid"
          },
          "timelineVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "mediaKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9/_.-]*$",
      "description": "Khóa object storage; không bao giờ là URL ký"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "ms": {
      "type": "integer",
      "minimum": 0
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "keyframes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atMs",
          "value"
        ],
        "properties": {
          "atMs": {
            "$ref": "#/$defs/ms"
          },
          "value": {
            "$ref": "#/$defs/volume"
          }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "muted",
        "volume",
        "items"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "enum": [
            "VIDEO",
            "NARRATION",
            "MUSIC",
            "SFX",
            "OVERLAY"
          ]
        },
        "muted": {
          "type": "boolean"
        },
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/imageItem"
        },
        {
          "$ref": "#/$defs/narrationItem"
        },
        {
          "$ref": "#/$defs/audioItem"
        }
      ]
    },
    "imageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "startMs",
        "durationMs",
        "shotId",
        "illustrationId",
        "mediaKey",
        "motion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "const": "IMAGE"
        },
        "startMs": {
          "$ref": "#/$defs/ms"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "shotId": {
          "$ref": "#/$defs/uuid"
        },
        "illustrationId": {
          "$ref": "#/$defs/uuid"
        },
        "mediaKey": {
          "$ref": "#/$defs/mediaKey"
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phases"
          ],
          "properties": {
            "phases": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "intensity",
                  "focusX",
                  "focusY",
                  "fromPct",
                  "toPct"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "NONE",
                      "ZOOM_IN",
                      "ZOOM_OUT",
                      "PAN_LEFT",
                      "PAN_RIGHT",
                      "PAN_UP",
                      "PAN_DOWN"
                    ]
                  },
                  "intensity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.5
                  },
                  "focusX": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "focusY": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "fromPct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "toPct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "transitionIn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "durationMs"
          ],
          "properties": {
            "type": {
              "enum": [
                "CUT",
                "CROSSFADE",
                "FADE",
                "FADE_BLACK",
                "FADE_WHITE",
                "SLIDE",
                "WIPE",
                "ZOOM"
              ]
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1500
            }
          }
        }
      }
    },
    "narrationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "startMs",
        "durationMs",
        "shotId",
        "narrationId",
        "mediaKey",
        "volume",
        "chapterId",
        "sourceStart",
        "sourceEnd",
        "sourceHash",
        "wordTimings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "const": "NARRATION"
        },
        "startMs": {
          "$ref": "#/$defs/ms"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "shotId": {
          "$ref": "#/$defs/uuid"
        },
        "narrationId": {
          "$ref": "#/$defs/uuid"
        },
        "mediaKey": {
          "$ref": "#/$defs/mediaKey",
          "description": "Audio thuyết minh (tốc độ đọc của dự án đã áp ở bước TTS, QĐ-140)"
        },
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "volumeKeyframes": {
          "$ref": "#/$defs/keyframes"
        },
        "chapterId": {
          "$ref": "#/$defs/uuid"
        },
        "sourceStart": {
          "type": "integer",
          "minimum": 0
        },
        "sourceEnd": {
          "type": "integer",
          "minimum": 1
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "wordTimings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "charStart",
              "charEnd",
              "startMs",
              "endMs"
            ],
            "properties": {
              "charStart": {
                "type": "integer",
                "minimum": 0
              },
              "charEnd": {
                "type": "integer",
                "minimum": 0
              },
              "startMs": {
                "$ref": "#/$defs/ms"
              },
              "endMs": {
                "$ref": "#/$defs/ms"
              }
            }
          }
        }
      }
    },
    "audioItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "startMs",
        "durationMs",
        "audioAssetId",
        "mediaKey",
        "sourceInMs",
        "volume"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "const": "AUDIO"
        },
        "startMs": {
          "$ref": "#/$defs/ms"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "audioAssetId": {
          "$ref": "#/$defs/uuid"
        },
        "mediaKey": {
          "$ref": "#/$defs/mediaKey"
        },
        "sourceInMs": {
          "$ref": "#/$defs/ms"
        },
        "loop": {
          "type": "boolean"
        },
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "volumeKeyframes": {
          "$ref": "#/$defs/keyframes"
        },
        "fadeInMs": {
          "$ref": "#/$defs/ms"
        },
        "fadeOutMs": {
          "$ref": "#/$defs/ms"
        },
        "duckingDb": {
          "type": "number",
          "minimum": -40,
          "maximum": -6,
          "description": "Bắt buộc khi chồng thuyết minh (BR-25); trần −6 dB"
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startMs",
        "endMs",
        "lines",
        "chapterId",
        "charStart",
        "charEnd"
      ],
      "properties": {
        "startMs": {
          "$ref": "#/$defs/ms"
        },
        "endMs": {
          "$ref": "#/$defs/ms"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 42
          }
        },
        "chapterId": {
          "$ref": "#/$defs/uuid"
        },
        "charStart": {
          "type": "integer",
          "minimum": 0
        },
        "charEnd": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "CHAPTER"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "timelineId",
          "timelineVersion"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "PROJECT"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "sourceTimelines"
        ]
      }
    }
  ]
}
