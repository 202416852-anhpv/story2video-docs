@startuml khoi-tao-storyboard-tu-dong
left to right direction

actor "Người dùng" as User
actor "Dịch vụ AI" as AI_Service

rectangle "Khởi tạo Storyboard tự động bằng AI" {
    usecase "Yêu cầu khởi tạo Storyboard tự động" as UC_01
    usecase "Đọc & phân tích văn bản kịch bản chương" as UC_02
    usecase "Tự động bóc tách thực thể (nhân vật, bối cảnh)" as UC_03
    usecase "Tự động tách shot theo nhịp truyện" as UC_04
    usecase "Tự động sinh Illustration Brief ban đầu" as UC_05
}

User --> UC_01

UC_01 ..> UC_02 : <<include>>
UC_01 ..> UC_03 : <<include>>
UC_01 ..> UC_04 : <<include>>
UC_01 ..> UC_05 : <<include>>

UC_02 --> AI_Service
UC_03 --> AI_Service
UC_04 --> AI_Service
UC_05 --> AI_Service

@enduml
