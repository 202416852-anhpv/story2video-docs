@startuml AI_Content_Studio_UseCase
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 10

' Styling actors & use cases
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #455A64
    ArrowColor #37474F
}
skinparam package {
    BackgroundColor #F8F9FA
    BorderColor #CFD8DC
}

left to right direction

' ==========================================
' ACTORS
' ==========================================
actor "Người dùng\n(Content Creator)" as User
actor "AI Speech-to-Text\n(Sherpa-onnx)" as STT_Service <<System>>
actor "AI Text-to-Speech\n(Edge TTS)" as TTS_Service <<System>>
actor "Render Service\n(FFmpeg / Desktop Agent)" as Render_Service <<System>>

' ==========================================
' SYSTEM BOUNDARY
' ==========================================
rectangle "Hệ thống AI Content Studio" {

    ' Phân hệ 1: Quản lý Dự án & Tài nguyên
    package "1. Quản lý Dự án & Tài nguyên" {
        usecase "UC01: Xem & Quản lý danh sách dự án" as UC_ListProj
        usecase "UC02: Tạo dự án mới" as UC_CreateProj
        usecase "UC03: Đổi tên / Xóa dự án" as UC_ManageProj
        usecase "UC04: Tự động lưu dự án (Auto-save)" as UC_AutoSave
        usecase "UC05: Tải lên video, ảnh, nhạc cá nhân" as UC_UploadMedia
        usecase "UC06: Khám phá thư viện Stock Music & SFX" as UC_StockMusic
    }

    ' Phân hệ 2: Kịch bản Voiceover & Xử lý AI
    package "2. Lồng tiếng AI & Kịch bản Voice" {
        usecase "UC07: Phiên âm video tự động" as UC_Transcribe
        usecase "UC08: Chỉnh sửa khối lời đọc (Voice Block)" as UC_EditVoiceBlock
        usecase "UC09: Chọn giọng đọc AI & Tốc độ" as UC_SelectVoice
        usecase "UC10: Tạo âm thanh lồng tiếng (TTS)" as UC_GenTTS
    }

    ' Phân hệ 3: Biên tập Timeline Đa Track
    package "3. Biên tập Timeline Đa Track" {
        usecase "UC11: Biên tập Track Voiceover" as UC_EditVoiceTrack
        usecase "UC12: Biên tập Track Video / Media" as UC_EditMediaTrack
        usecase "UC13: Biên tập Track Music (Loop & Trim)" as UC_EditMusicTrack
        usecase "UC14: Điều chỉnh âm lượng các track" as UC_AdjustVolume
        usecase "UC15: Hoàn tác & Làm lại (Undo / Redo)" as UC_UndoRedo
    }

    ' Phân hệ 4: Phụ đề, Trình phát & Xuất bản
    package "4. Phụ đề & Xuất bản Video" {
        usecase "UC16: Bật/Tắt & Áp dụng Preset Phụ đề" as UC_ApplyCaptionPreset
        usecase "UC17: Tùy chỉnh sâu kiểu chữ & Hiệu ứng phụ đề" as UC_CustomizeCaption
        usecase "UC18: Xem trước video đồng bộ 3 track" as UC_PreviewVideo
        usecase "UC19: Cấu hình tỷ lệ khung hình (Aspect Ratio)" as UC_ConfigAspectRatio
        usecase "UC20: Xuất và tải xuống video MP4" as UC_ExportVideo
    }
}

' ==========================================
' RELATIONSHIPS: USER -> USE CASES
' ==========================================
User --> UC_ListProj
User --> UC_CreateProj
User --> UC_ManageProj
User --> UC_UploadMedia
User --> UC_StockMusic

User --> UC_EditVoiceBlock
User --> UC_SelectVoice

User --> UC_EditVoiceTrack
User --> UC_EditMediaTrack
User --> UC_EditMusicTrack
User --> UC_AdjustVolume
User --> UC_UndoRedo

User --> UC_ApplyCaptionPreset
User --> UC_PreviewVideo
User --> UC_ConfigAspectRatio
User --> UC_ExportVideo

' ==========================================
' RELATIONSHIPS: EXTERNAL SYSTEMS -> USE CASES
' ==========================================
UC_Transcribe --> STT_Service
UC_GenTTS --> TTS_Service
UC_ExportVideo --> Render_Service

' ==========================================
' USE CASE TO USE CASE (include / extend)
' ==========================================

' Khi tạo dự án thì bắt buộc upload video và chạy phiên âm AI
UC_CreateProj ..> UC_UploadMedia : <<include>>
UC_CreateProj ..> UC_Transcribe : <<include>>

' Khi phát video xem trước hoặc xuất video thì phải đảm bảo có TTS audio
UC_PreviewVideo ..> UC_GenTTS : <<include>>
UC_ExportVideo ..> UC_GenTTS : <<include>>

' Tùy chỉnh chi tiết phụ đề mở rộng từ việc áp dụng Preset
UC_CustomizeCaption ..> UC_ApplyCaptionPreset : <<extend>>

' Hoàn tác/Làm lại mở rộng cho các thao tác chỉnh sửa khối và track
UC_UndoRedo ..> UC_EditVoiceBlock : <<extend>>
UC_UndoRedo ..> UC_EditVoiceTrack : <<extend>>
UC_UndoRedo ..> UC_EditMediaTrack : <<extend>>
UC_UndoRedo ..> UC_EditMusicTrack : <<extend>>

' Tự động lưu mở rộng cho việc biên tập dự án
UC_AutoSave ..> UC_EditVoiceBlock : <<extend>>

@enduml
