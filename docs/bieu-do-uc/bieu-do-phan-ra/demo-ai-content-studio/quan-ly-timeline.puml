@startuml UC_QuanLyDongThoiGian
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #455A64
    ArrowColor #37474F
}

left to right direction

actor "Người dùng" as User

rectangle "Phân hệ: Quản lý Dòng thời gian (Timeline)" {
    usecase "Kéo thả sắp xếp vị trí khối" as UC_MoveBlock
    usecase "Co giãn & Cắt xén khối Voice (Trim)" as UC_TrimVoice
    usecase "Chèn & Cắt xén Video/Ảnh (Media Track)" as UC_TrimMedia
    usecase "Chèn & Kéo giãn lặp lại Nhạc nền (Loop Music)" as UC_LoopMusic
    usecase "Điều chỉnh âm lượng từng track (Voice/Media/Music)" as UC_TrackVolume
    usecase "Thu phóng Timeline (Zoom 10 - 120 px/s)" as UC_Zoom
    usecase "Hoàn tác & Làm lại (Undo / Redo)" as UC_UndoRedo
}

User --> UC_MoveBlock
User --> UC_TrimVoice
User --> UC_TrimMedia
User --> UC_LoopMusic
User --> UC_TrackVolume
User --> UC_Zoom
User --> UC_UndoRedo

' Mối quan hệ extend: Undo/Redo mở rộng cho các thao tác thay đổi timeline
UC_UndoRedo ..> UC_MoveBlock : <<extend>>
UC_UndoRedo ..> UC_TrimVoice : <<extend>>
UC_UndoRedo ..> UC_TrimMedia : <<extend>>
UC_UndoRedo ..> UC_LoopMusic : <<extend>>

@enduml
