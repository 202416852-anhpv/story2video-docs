@startuml UC_DungVaXuatVideo
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #455A64
    ArrowColor #37474F
}

left to right direction

actor "Người dùng" as User
actor "AI Text-to-Speech" as TTS <<System>>
actor "Desktop Agent (Electron GPU)" as LocalAgent <<System>>
actor "Backend Server (FFmpeg/Node)" as CloudServer <<System>>

rectangle "Phân hệ: Dựng & Xuất Video" {
    usecase "Bật / Tắt hiển thị phụ đề" as UC_ToggleCaption
    usecase "Áp dụng Preset phụ đề (12 mẫu)" as UC_ApplyPreset
    usecase "Tùy biến nâng cao (Font, Màu, Hiệu ứng, Highlight từ)" as UC_CustomStyle
    usecase "Tùy chỉnh tỷ lệ khung hình & Màu nền" as UC_AspectRatio
    usecase "Xem trước video đồng bộ 3 track (Canvas Preview)" as UC_Preview
    usecase "Sinh toàn bộ audio TTS trước khi phát/xuất" as UC_BatchTTS
    
    usecase "Yêu cầu Xuất video (Export Video)" as UC_Export
    usecase "Xuất cục bộ qua Desktop Agent (GPU HW)" as UC_ExportLocal
    usecase "Xuất qua Cloud Server (Web Backend)" as UC_ExportCloud
    usecase "Tải xuống video MP4 thành phẩm" as UC_Download
}

User --> UC_ToggleCaption
User --> UC_ApplyPreset
User --> UC_AspectRatio
User --> UC_Preview
User --> UC_Export

' Phụ đề: tùy biến mở rộng từ Preset
UC_CustomStyle .> UC_ApplyPreset : <<extend>>

' Preview và Export bắt buộc phải hoàn thành TTS trước
UC_Preview ..> UC_BatchTTS : <<include>>
UC_Export ..> UC_BatchTTS : <<include>>
UC_BatchTTS --> TTS : Yêu cầu tổng hợp giọng đọc

' Kế thừa (Generalization) 2 phương thức render
UC_ExportLocal -up-|> UC_Export
UC_ExportCloud -up-|> UC_Export

UC_ExportLocal --> LocalAgent : Chạy render NVENC/QSV/AMF
UC_ExportCloud --> CloudServer : Chạy render ffmpeg + node canvas

' Tải xuống sau khi xuất thành công
UC_Download .> UC_Export : <<extend>>

@enduml
