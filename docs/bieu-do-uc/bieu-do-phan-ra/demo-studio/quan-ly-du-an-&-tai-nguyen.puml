@startuml UC_QuanLyDuAn
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #455A64
    ArrowColor #37474F
}

left to right direction

actor "Người dùng" as User
actor "AI Speech-to-Text" as STT <<System>>

rectangle "Phân hệ: Quản lý Dự án & Tài nguyên" {
    usecase "Xem danh sách dự án" as UC_List
    usecase "Tìm kiếm & Phân trang dự án" as UC_Search
    usecase "Tạo dự án mới" as UC_Create
    usecase "Tải lên video gốc (MP4)" as UC_UploadVideo
    usecase "Phiên âm tự động khi tạo" as UC_AutoTranscribe
    usecase "Đổi tên dự án" as UC_Rename
    usecase "Xóa dự án" as UC_Delete
    usecase "Tự động lưu dự án (Auto-save)" as UC_AutoSave
    usecase "Tải lên media / nhạc cá nhân" as UC_UploadAssets
    usecase "Khám phá thư viện Stock Music & SFX" as UC_StockLibrary
}

User --> UC_List
User --> UC_Create
User --> UC_Rename
User --> UC_Delete
User --> UC_UploadAssets
User --> UC_StockLibrary

' Include / Extend relationships
UC_List <.. UC_Search : <<extend>>
UC_Create ..> UC_UploadVideo : <<include>>
UC_Create ..> UC_AutoTranscribe : <<include>>
UC_AutoTranscribe --> STT : Yêu cầu chuyển Speech-to-Text

' Tự động lưu mở rộng ngầm khi có thay đổi
UC_AutoSave .> UC_Create : <<extend>>
UC_AutoSave .> UC_Rename : <<extend>>

@enduml
