@startuml dang-ky-dang-nhap
left to right direction

actor "Người dùng" as User
actor "SSO Vbee" as SSO_Vbee

rectangle "Đăng ký và đăng nhập" {
    usecase "Đăng nhập qua SSO Vbee" as UC_01
    usecase "Đăng ký tài khoản mới" as UC_02
    usecase "Tạo / Đồng bộ hồ sơ người dùng" as UC_03
    usecase "Đăng xuất khỏi hệ thống" as UC_04
    usecase "Đăng xuất khỏi SSO Vbee" as UC_05
    usecase "Mở trang quản lý tài khoản Vbee" as UC_06
}

User --> UC_01
User --> UC_02
User --> UC_04
User --> UC_06

UC_01 <.. UC_02 : <<extend>>
UC_01 ..> UC_03 : <<include>>
UC_04 ..> UC_05 : <<include>>

UC_01 --> SSO_Vbee
UC_02 --> SSO_Vbee
UC_05 --> SSO_Vbee
UC_06 --> SSO_Vbee

@enduml
