@startuml dung-va-xuat-video
left to right direction

actor "Người dùng" as User
actor "Dịch vụ AI" as AI_Service
actor "Hệ thống Render" as Render_Service

rectangle "Dựng & xuất video" {
    usecase "Thiết lập khung hình và bố cục video" as UC_01
    usecase "Thêm nhạc nền và hiệu ứng âm thanh" as UC_02
    usecase "Dựng video trên Timeline đa lớp\n(giọng đọc, hình ảnh/video, nhạc nền/hiệu ứng)" as UC_04
    usecase "Thiết lập phụ đề video" as UC_05
    usecase "Xem trước & Xuất video" as UC_06
}

User --> UC_01
User --> UC_02
User --> UC_04
User --> UC_05
User --> UC_06

UC_04 --> AI_Service
UC_05 --> AI_Service
UC_06 --> Render_Service

@enduml
