@startuml tuy-chinh-hinh-anh-phan-canh
left to right direction

actor "Người dùng" as User
actor "Dịch vụ AI" as AI_Service

rectangle "Tùy chỉnh hình ảnh phân cảnh" {
    usecase "Xem hình ảnh phân cảnh hiện tại" as UC_01
    usecase "Tải ảnh mới từ thiết bị để thay thế" as UC_02
    usecase "Thay ảnh bằng video clip" as UC_03
    usecase "Xóa ảnh khỏi phân cảnh" as UC_04
    usecase "Chọn ảnh/video từ Thư viện tài nguyên" as UC_05
    usecase "Yêu cầu AI sinh lại ảnh minh họa mới" as UC_06
    usecase "Cắt cúp & Căn chỉnh vị trí hình ảnh (Crop/Scale)" as UC_07
}

User --> UC_01
User --> UC_02
User --> UC_03
User --> UC_04
User --> UC_05
User --> UC_06
User --> UC_07

UC_06 --> AI_Service

UC_02 <.. UC_03 : <<extend>>

@enduml
