@startuml xem-truoc-va-xuat-video
left to right direction

actor "Người dùng" as User
actor "Hệ thống Render" as Render_Service

rectangle "Xem trước & Xuất video" {
    usecase "Xem trước video" as UC_01
    usecase "Tua và tạm dừng video" as UC_02
    usecase "Xuất video" as UC_04
    usecase "Theo dõi tiến độ render video" as UC_05
    usecase "Tải video" as UC_06
}

User --> UC_01
User --> UC_02
User --> UC_04

UC_04 ..> UC_05 : <<include>>
UC_04 <.. UC_06 : <<extend>>

UC_04 --> Render_Service
@enduml
