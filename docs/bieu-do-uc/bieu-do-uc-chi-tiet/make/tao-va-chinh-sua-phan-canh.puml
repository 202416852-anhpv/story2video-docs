@startuml tao-va-chinh-sua-phan-canh
left to right direction

actor "Người dùng" as User
actor "AI phân tích truyện" as AI_LLM
actor "AI sinh ảnh" as AI_IMG

rectangle "Tạo & chỉnh sửa phân cảnh" {
    usecase "Tự động tạo kịch bản phân cảnh" as UC_04
    usecase "Tự động chia phân cảnh" as UC_01
    usecase "Biên tập phân cảnh" as UC_02
    usecase "Tạo và tùy chỉnh hình ảnh minh họa" as UC_03
}

User --> UC_04
User --> UC_02

UC_04 ..> UC_01 : <<include>>
UC_04 ..> UC_03 : <<include>>

UC_01 --> AI_LLM
UC_03 --> AI_IMG

@enduml
