@startuml quan-ly-du-an
left to right direction

actor "Người dùng" as User
actor "Cộng tác viên" as Editor
actor "Chủ dự án" as Owner

Editor -|> User
Owner -|> Editor

rectangle "Quản lý dự án" {
    usecase "Xem danh sách dự án" as UC_01
    usecase "Tìm kiếm / lọc dự án" as UC_02
    usecase "Tải truyện lên" as UC_03
    usecase "Kiểm tra và chuẩn hóa kỹ thuật" as UC_03a
    usecase "Tạo dự án trống" as UC_04
    usecase "Cài đặt dự án" as UC_05
    usecase "Xóa dự án" as UC_06
    usecase "Tạo / thu hồi link mời" as UC_07
    usecase "Quản lý thành viên (xem / xóa)" as UC_08
    usecase "Tham gia dự án qua link" as UC_09
    usecase "Xem tiến độ dự án" as UC_10
    usecase "Nhân bản dự án" as UC_11
}

User --> UC_01
UC_01 <.. UC_02 : <<extend>>
User --> UC_03
UC_03 ..> UC_03a : <<include>>
User --> UC_04
Owner --> UC_05
Owner --> UC_06
Owner --> UC_07
Owner --> UC_08
User --> UC_09

Editor --> UC_10
Owner --> UC_11

@enduml
