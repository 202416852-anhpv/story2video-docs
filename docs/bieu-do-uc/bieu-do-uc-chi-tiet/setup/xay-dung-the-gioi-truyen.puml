@startuml xay-dung-the-gioi-truyen
left to right direction

actor "Người dùng" as User
actor "Dịch vụ AI" as AI_Service

rectangle "Xây dựng thế giới truyện" {
    usecase "Quản lý nhân vật trong truyện" as UC_01
    usecase "Quản lý vật phẩm trong truyện" as UC_02
    usecase "Quản lý địa điểm trong truyện" as UC_03
    usecase "Quản lý phong cách nghệ thuật của truyện" as UC_04
    usecase "Quản lý dòng thời gian của truyện" as UC_05
    usecase "Quản lý mối quan hệ giữa các nhân vật" as UC_06
}

User --> UC_01
User --> UC_02
User --> UC_03
User --> UC_04
User --> UC_05
User --> UC_06

UC_01 --> AI_Service
UC_02 --> AI_Service
UC_03 --> AI_Service
UC_04 --> AI_Service
UC_05 --> AI_Service
UC_06 --> AI_Service

@enduml
