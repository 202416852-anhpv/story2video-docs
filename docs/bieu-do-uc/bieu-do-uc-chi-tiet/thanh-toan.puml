@startuml thanh-toan
left to right direction

actor "Người dùng" as User
actor "Hệ thống thanh toán" as PAY_SYS

rectangle "Thanh toán & Credit" {
    usecase "Xem bảng giá & các gói" as UC_01
    usecase "Đăng ký gói (tháng / năm)" as UC_02
    usecase "Mua gói credit" as UC_03
    usecase "Quản lý thanh toán\n(nâng/hạ gói, đổi thẻ, hóa đơn, hủy gói)" as UC_04
    usecase "Xem số dư credit" as UC_05
    usecase "Xem lịch sử tiêu credit" as UC_06
    usecase "Nhận credit miễn phí hằng ngày\n(gói Free)" as UC_07
    usecase "Thanh toán qua cổng thanh toán" as UC_08
    usecase "Cập nhật gói & cấp credit\nsau thanh toán" as UC_09
}

User --> UC_01
User --> UC_02
User --> UC_03
User --> UC_04
User --> UC_05
User --> UC_06
User --> UC_07

UC_02 ..> UC_08 : <<include>>
UC_03 ..> UC_08 : <<include>>
UC_04 ..> UC_09 : <<include>>

UC_08 ..> UC_09 : <<include>>

UC_04 --> PAY_SYS
UC_08 --> PAY_SYS
UC_09 --> PAY_SYS

@enduml
