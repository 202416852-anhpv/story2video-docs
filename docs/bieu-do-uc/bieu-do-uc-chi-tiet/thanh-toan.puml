@startuml thanh-toan
left to right direction

actor "Guest" as Guest
actor "User" as User
actor "Hệ thống thanh toán" as PAY
User -|> Guest

rectangle "Thanh toán" {
    usecase "Xem bảng giá" as UC1
    usecase "Đăng ký gói" as UC2
    usecase "Mua gói credit" as UC3
    usecase "Thanh toán qua checkout" as UC3a
    usecase "Quản lý thanh toán\n(đổi gói, thẻ, hóa đơn, hủy)" as UC4
    usecase "Xem số dư credit" as UC5
    usecase "Xem lịch sử tiêu credit" as UC6
    usecase "Nhận credit hằng ngày" as UC7
    usecase "Xử lý webhook thanh toán" as UC8
    usecase "Cập nhật gói & nạp credit" as UC8a
}

Guest --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
UC2 ..> UC3a : <<include>>
UC3 ..> UC3a : <<include>>
UC8 ..> UC8a : <<include>>
UC3a --> PAY
UC4 --> PAY
PAY --> UC8

@enduml
