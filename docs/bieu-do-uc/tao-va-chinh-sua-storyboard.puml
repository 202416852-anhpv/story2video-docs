@startuml tao-va-chinh-sua-storyboard
left to right direction

actor "Người dùng" as User
actor "Dịch vụ AI" as AI_Service

rectangle "Tạo & chỉnh sửa storyboard" {
    usecase "Khởi tạo Storyboard tự động" as UC_01
    usecase "Biên tập cấu trúc phân cảnh" as UC_02
    usecase "Tạo & tùy chỉnh hình ảnh minh họa" as UC_03
    usecase "Quản lý phiên bản Storyboard" as UC_04
}

User --> UC_01
User --> UC_02
User --> UC_03
User --> UC_04

UC_01 --> AI_Service
UC_02 --> AI_Service
UC_03 --> AI_Service

@enduml
