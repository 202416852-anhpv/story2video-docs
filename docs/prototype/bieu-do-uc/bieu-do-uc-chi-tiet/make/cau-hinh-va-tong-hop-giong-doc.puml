actor "AI sinh giọng đọc" as AI_TTS

rectangle "Cấu hình & tổng hợp giọng đọc" {
    usecase "Cấu hình giọng đọc" as UC_01
    usecase "Điều chỉnh tốc độ đọc và mức nhấn nhá" as UC_02
    usecase "Tổng hợp giọng đọc" as UC_03
    usecase "Chọn giọng đọc cho chương truyện" as UC_04
    usecase "Sinh giọng đọc cho từng phân cảnh" as UC_05
    usecase "Sinh giọng đọc cho toàn bộ chương truyện" as UC_07
    usecase "Nghe thử giọng đọc" as UC_06
    usecase "Sinh lại giọng đọc cho từng phân cảnh,\nchương truyện" as UC_08
}

User --> UC_01
User --> UC_03
User --> UC_06
User --> UC_08
UC_01 <|-- UC_02
UC_01 <|-- UC_04
UC_03 <|-- UC_05
