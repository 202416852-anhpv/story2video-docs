@startuml dung-va-xuat-video
left to right direction

actor "Người dùng" as User
actor "Hệ thống Render" as Render_Service

rectangle "Dựng & xuất video" {
    usecase "Thiết lập khung hình và bố cục video" as UC_01
    usecase "Xem trước video" as UC_02
    usecase "Xuất video" as UC_03
    usecase "Thiết lập hiệu ứng chuyển cảnh" as UC_04
}

User --> UC_01
User --> UC_02
User --> UC_03
User --> UC_04

UC_02 --> Render_Service

@enduml
