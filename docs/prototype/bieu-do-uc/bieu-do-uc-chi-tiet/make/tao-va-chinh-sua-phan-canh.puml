@startuml tao-va-chinh-sua-phan-canh
left to right direction

actor "Người dùng" as User
actor "AI phân tích truyện" as AI_LLM
actor "AI sinh ảnh" as AI_IMG

rectangle "Tạo & chỉnh sửa phân cảnh" {
    usecase "Tạo kịch bản phân cảnh" as UC_04
    usecase "Tự động chia phân cảnh, tạo prompt\nsinh ảnh mình họa cho phân cảnh" as UC_01
    usecase "Chỉnh sửa prompt sinh\nảnh minh họa cho phân cảnh" as UC_05
    usecase "Sinh lại ảnh minh họa cho phân cảnh" as UC_06
    usecase "Sinh ảnh minh họa cho toàn bộ chương truyện" as UC_03
    usecase "Sinh ảnh minh họa cho từng phân cảnh" as UC_07
}

User --> UC_04
User --> UC_03
User --> UC_07
User --> UC_05
User --> UC_06

UC_04 ..> UC_01 : <<include>>

UC_01 --> AI_LLM
UC_03 --> AI_IMG
UC_07 --> AI_IMG
UC_06 --> AI_IMG

@enduml
