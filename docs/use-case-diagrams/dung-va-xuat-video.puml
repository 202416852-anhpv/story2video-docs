@startuml dung-va-xuat-video
title Dựng & xuất video
left to right direction

actor "Người dùng" as User
actor "Dịch vụ AI" as AI_Service

rectangle "Dựng & xuất video" {
    usecase "Cấu hình tỷ lệ khung hình video" as UC_01
    usecase "Tự động xây dựng timeline video" as UC_02
    usecase "Biên tập âm thanh nền & hiệu ứng" as UC_03
    usecase "Cấu hình phụ đề video" as UC_04
    usecase "Thiết lập hiệu ứng & chuyển cảnh" as UC_05
    usecase "Xem trước video (Preview)" as UC_06
    usecase "Khởi tạo kết xuất video MP4" as UC_07
    usecase "Tải về video hoàn chỉnh" as UC_08
}

User --> UC_01
User --> UC_02
User --> UC_03
User --> UC_04
User --> UC_05
User --> UC_06
User --> UC_07
User --> UC_08

UC_02 --> AI_Service
UC_07 --> AI_Service

@enduml
