@startuml bien-tap-cau-truc-phan-canh
left to right direction

actor "Người dùng" as User
actor "Dịch vụ AI" as AI_Service

rectangle "Biên tập cấu trúc phân cảnh" {
    usecase "Chỉnh sửa nội dung câu thoại / lời dẫn từng shot" as UC_01
    usecase "Thêm shot mới" as UC_02
    usecase "Xóa shot" as UC_03
    usecase "Sắp xếp lại thứ tự shot" as UC_04
    usecase "Tái cấu trúc / Chia lại phân cảnh" as UC_05
    usecase "Dự tính số lượng shot thay đổi" as UC_06
}

User --> UC_01
User --> UC_02
User --> UC_03
User --> UC_04
User --> UC_05

UC_05 ..> UC_06 : <<include>>
UC_05 --> AI_Service

@enduml
